{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|webp|svg|ico|woff2|wasm))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(sw\\.js|index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/baobab/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/baobab/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/baobab",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/event/:id",
      "destination": "/api/preview?id=:id"
    },
    {
      "source": "/((?!api/|event/).*)",
      "destination": "/index.html"
    }
  ]
}
