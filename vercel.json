{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/baobab/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/baobab/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/baobab",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/event/:id",
      "destination": "/api/preview?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
