# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CREDENTIALS FOR THIESDN BILLETTERIE (Thiès, Mbour, Saly, Dakar)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# CARTO BASEMAPS API KEY (Dark Matter & Voyager)
VITE_CARTO_API_KEY="your-carto-api-key"

# CLOUDFLARE TURNSTILE SITE KEY (Supabase Auth CAPTCHA — clé de test locale: 1x00000000000000000000AA)
VITE_TURNSTILE_SITE_KEY="votre_site_key_cloudflare"
