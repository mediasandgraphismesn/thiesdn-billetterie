  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Bell, Sparkles, Shield, User, Crown, Plus, Check } from \'lucide-react\';\nimport { NotificationItem, UserProfile } from \'../types\';\n\ninterface HeaderProps {\n  user: UserProfile;\n  notifications: NotificationItem[];\n  onMarkNotificationRead: (id: string) => void;\n  onClearNotifications: () => void;\n  currentRole: \'user\' | \'promoter\' | \'admin\';\n  onChangeRole: (role: \'user\' | \'promoter\' | \'admin\') => void;\n  ambientShader: boolean;\n  onToggleShader: () => void;\n  onOpenCreateModal: () => void;\n  pendingModerationCount: number;\n  onNavigate: (tab: string) => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  user,\n  notifications,\n  onMarkNotificationRead,\n  onClearNotifications,\n  currentRole,\n  onChangeRole,\n  ambientShader,\n  onToggleShader,\n  onOpenCreateModal,\n  pendingModerationCount,\n  onNavigate,\n}) => {\n  const [showNotifications, setShowNotifications] = useState(false);\n  const [showRoleSelector, setShowRoleSelector] = useState(false);\n\n  const unreadCount = notifications.filter((n) => !n.read).length;\n\n  return (\n    <header className=\"bg-[#131313]/80 backdrop-blur-xl border-b border-white/10 sticky top-0 z-50 px-4 sm:px-6 h-16 w-full flex items-center justify-between transition-all\">\n      {/* Brand & Logo */}\n      <div \n        onClick={() => onNavigate(\'home\')}\n        className=\"flex items-center gap-3 cursor-pointer group\"\n      >\n        <div className=\"w-9 h-9 rounded-full bg-gradient-to-tr from-[#8A2BE2] via-[#241A00] to-[#E9C349] p-[1.5px] shadow-lg shadow-[#8A2BE2]/20 group-hover:scale-105 transition-transform\">\n          <div className=\"w-full h-full rounded-full bg-[#131313] flex items-center justify-center overflow-hidden\">\n            {/* Stylized geometric T monogram */}\n            <span className=\"font-heading font-extrabold text-sm tracking-tighter bg-gradient-to-r from-[#DCB8FF] to-[#E9C349] bg-clip-text text-transparent\">\n              th\n            </span>\n          </div>\n        </div>\n        <div>\n          <h1 className=\"font-heading text-lg sm:text-xl font-bold tracking-tight text-[#DCB8FF] flex items-center gap-1.5\">\n            Thiesdn <span className=\"text-white font-normal text-sm sm:text-base opacity-90\">Billetterie</span>\n          </h1>\n          <p className=\"text-[10px] uppercase font-semibold tracking-wider text-[#E9C349] -mt-1 hidden sm:block\">\n            Acc\303\250s Exclusif\n          </p>\n        </div>\n      </div>\n\n      {/* Center Shortcuts on Desktop */}\n      <div className=\"hidden md:flex items-center gap-2 bg-[#1C1B1B]/80 px-3 py-1 rounded-full border border-white/5\">\n        <button\n          onClick={() => onChangeRole(\'user\')}\n          className={`flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition-all ${\n            currentRole === \'user\'\n              ? \'bg-[#8A2BE2] text-white shadow-md shadow-[#8A2BE2]/30\'\n              : \'text-[#CFC2D7] hover:text-white\'\n          }`}\n        >\n          <User className=\"w-3.5 h-3.5\" />\n          Membre VIP\n        </button>\n        <button\n          onClick={() => onChangeRole(\'promoter\')}\n          className={`flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition-all ${\n            currentRole === \'promoter\'\n              ? \'bg-[#E9C349] text-[#241A00] shadow-md shadow-[#E9C349]/30 font-bold\'\n              : \'text-[#CFC2D7] hover:text-white\'\n          }`}\n        >\n          <Crown className=\"w-3.5 h-3.5\" />\n          Promoteur\n        </button>\n        <button\n          onClick={() => onChangeRole(\'admin\')}\n          className={`flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold transition-all relative ${\n            currentRole === \'admin\'\n              ? \'bg-[#8A2BE2] text-white shadow-md shadow-[#8A2BE2]/30\'\n              : \'text-[#CFC2D7] hover:text-white\'\n          }`}\n        >\n          <Shield className=\"w-3.5 h-3.5\" />\n          Admin Mod\303\251ration\n          {pendingModerationCount > 0 && (\n            <span className=\"w-2 h-2 rounded-full bg-[#E9C349] animate-pulse\" />\n          )}\n        </button>\n      </div>\n\n      {/* Right Controls */}\n      <div className=\"flex items-center gap-2 sm:gap-3\">\n        {/* Create Event CTA for Promoters / Admins */}\n        <button\n          onClick={onOpenCreateModal}\n          className=\"hidden sm:flex items-center gap-1.5 bg-[#8A2BE2]/20 hover:bg-[#8A2BE2] text-[#DCB8FF] hover:text-white px-3.5 py-1.5 rounded-lg border border-[#8A2BE2]/40 text-xs font-bold tracking-wide transition-all shadow-sm\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Cr\303\251er un \303\211v\303\251nement</span>\n        </button>\n\n        {/* Ambient Shader background toggle */}\n        <button\n          onClick={onToggleShader}\n          title={ambientShader ? \'D\303\251sactiver effets d\342\200\231ambiance\' : \'Activer effets d\342\200\231ambiance n\303\251on\'}\n          className={`p-2 rounded-full border transition-all ${\n            ambientShader\n              ? \'bg-[#8A2BE2]/20 border-[#8A2BE2]/50 text-[#DCB8FF]\'\n              : \'bg-[#1C1B1B] border-white/5 text-gray-400 hover:text-white\'\n          }`}\n        >\n          <Sparkles className=\"w-4 h-4\" />\n        </button>\n\n        {/* Notifications Popover */}\n        <div className=\"relative\">\n          <button\n            onClick={() => setShowNotifications(!showNotifications)}\n            className=\"p-2 rounded-full bg-[#1C1B1B] hover:bg-[#2A2A2A] border border-white/10 text-[#DCB8FF] transition-all relative\"\n            aria-label=\"Notifications\"\n          >\n            <Bell className=\"w-5 h-5\" />\n            {unreadCount > 0 && (\n              <span className=\"absolute -top-1 -right-1 w-4 h-4 bg-[#E9C349] text-[#241A00] rounded-full text-[10px] font-extrabold flex items-center justify-center shadow-md\">\n                {unreadCount}\n              </span>\n            )}\n          </button>\n\n          {showNotifications && (\n            <div className=\"absolute right-0 mt-3 w-80 sm:w-96 glass-panel rounded-2xl p-4 shadow-2xl z-50 animate-in fade-in slide-in-from-top-2 duration-200\">\n              <div className=\"flex items-center justify-between pb-3 border-b border-white/10\">\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"font-heading font-bold text-sm text-white\">Notifications</h3>\n                  {unreadCount > 0 && (\n                    <span className=\"bg-[#8A2BE2]/30 text-[#DCB8FF] text-[11px] font-semibold px-2 py-0.5 rounded-full\">\n                      {unreadCount} nouvelles\n                    </span>\n                  )}\n                </div>\n                {unreadCount > 0 && (\n                  <button\n                    onClick={onClearNotifications}\n                    className=\"text-xs text-[#E9C349] hover:underline\"\n                  >\n                    Tout marquer comme lu\n                  </button>\n                )}\n              </div>\n\n              <div className=\"mt-3 space-y-2 max-h-80 overflow-y-auto\">\n                {notifications.length === 0 ? (\n                  <p className=\"text-xs text-gray-400 text-center py-6\">Aucune notification pour le moment.</p>\n                ) : (\n                  notifications.map((notif) => (\n                    <div\n                      key={notif.id}\n                      onClick={() => onMarkNotificationRead(notif.id)}\n                      className={`p-3 rounded-xl cursor-pointer transition-colors text-left flex gap-3 items-start ${\n                        notif.read\n                          ? \'bg-[#1A1A1A]/40 text-gray-400\'\n                          : \'bg-[#8A2BE2]/10 border border-[#8A2BE2]/30 text-white\'\n                      }`}\n                    >\n                      <div className={`p-2 rounded-lg mt-0.5 ${\n                        notif.type === \'vip\' ? \'bg-[#E9C349]/20 text-[#E9C349]\' : \'bg-[#8A2BE2]/20 text-[#DCB8FF]\'\n                      }`}>\n                        {notif.type === \'vip\' ? <Crown className=\"w-4 h-4\" /> : <Sparkles className=\"w-4 h-4\" />}\n                      </div>\n                      <div className=\"flex-1\">\n                        <div className=\"flex items-center justify-between\">\n                          <p className=\"font-semibold text-xs text-white\">{notif.title}</p>\n                          <span className=\"text-[10px] text-gray-400\">{notif.timestamp}</span>\n                        </div>\n                        <p className=\"text-xs text-gray-300 mt-1 leading-relaxed\">{notif.message}</p>\n                      </div>\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* User Avatar & Role trigger */}\n        <div \n          onClick={() => onNavigate(\'profile\')}\n          className=\"flex items-center gap-2 pl-1 cursor-pointer group\"\n        >\n          <div className=\"relative\">\n            <div className=\"w-8 h-8 rounded-full overflow-hidden border border-[#8A2BE2]/80 group-hover:border-[#E9C349] transition-colors\">\n              <img\n                src={user.avatar}\n                alt={user.name}\n                className=\"w-full h-full object-cover\"\n              />\n            </div>\n            {user.isVip && (\n              <span className=\"absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-[#E9C349] text-[#241A00] rounded-full flex items-center justify-center text-[8px] font-bold\">\n                \342\230\205\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
