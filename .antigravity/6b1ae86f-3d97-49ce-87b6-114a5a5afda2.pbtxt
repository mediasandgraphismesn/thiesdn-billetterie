      replacement_content: "import React from \'react\';\nimport { Home, Compass, Ticket, ShieldCheck, User } from \'lucide-react\';\n\ninterface BottomNavProps {\n  activeTab: string;\n  onTabChange: (tab: string) => void;\n  pendingCount?: number;\n  ticketsCount?: number;\n  userRole: \'user\' | \'promoter\' | \'admin\';\n}\n\nexport const BottomNav: React.FC<BottomNavProps> = ({\n  activeTab,\n  onTabChange,\n  pendingCount = 0,\n  ticketsCount = 0,\n  userRole,\n}) => {\n  const tabs = [\n    { id: \'home\', label: \'Home\', icon: Home },\n    { id: \'explore\', label: \'Explore\', icon: Compass },\n    {\n      id: \'tickets\',\n      label: \'Tickets\',\n      icon: Ticket,\n      badge: ticketsCount > 0 ? ticketsCount : undefined,\n    },\n    ...(userRole === \'admin\' || userRole === \'promoter\'\n      ? [\n          {\n            id: \'moderation\',\n            label: \'Mod\303\251ration\',\n            icon: ShieldCheck,\n            badge: pendingCount > 0 ? pendingCount : undefined,\n            badgeColor: \'bg-[#E9C349] text-[#241A00]\',\n          },\n        ]\n      : []),\n    { id: \'profile\', label: \'Profile\', icon: User },\n  ];\n\n  return (\n    <nav className=\"md:hidden fixed bottom-4 left-4 right-4 h-18 max-w-md mx-auto z-50 flex items-center justify-around px-3 bg-[#1C1B1B]/80 backdrop-blur-2xl rounded-full border border-white/10 shadow-2xl shadow-[#8A2BE2]/15\">\n      {tabs.map((tab) => {\n        const Icon = tab.icon;\n        const isActive = activeTab === tab.id;\n\n        return (\n          <button\n            key={tab.id}\n            onClick={() => onTabChange(tab.id)}\n            className={`relative flex flex-col items-center justify-center transition-all py-2 px-3 rounded-full ${\n              isActive\n                ? \'bg-[#8A2BE2] text-white shadow-lg shadow-[#8A2BE2]/40 scale-105\'\n                : \'text-[#CFC2D7] hover:text-white opacity-75\'\n            }`}\n          >\n            <div className=\"relative\">\n              <Icon className={`w-5 h-5 ${isActive ? \'stroke-[2.5]\' : \'stroke-[1.8]\'}`} />\n              {tab.badge !== undefined && (\n                <span\n                  className={`absolute -top-1.5 -right-2 text-[9px] font-extrabold px-1.5 py-0.2 rounded-full min-w-[16px] text-center ${\n                    tab.badgeColor || \'bg-[#8A2BE2] text-white\'\n                  }`}\n                >\n                  {tab.badge}\n                </span>\n              )}\n            </div>\n            <span\n              className={`text-[10px] font-semibold mt-0.5 tracking-tight ${\n                isActive ? \'text-white\' : \'text-[#CFC2D7]\'\n              }`}\n            >\n              {tab.label}\n            </span>\n          </button>\n        );\n      })}\n    </nav>\n  );\n};\n"
    }
