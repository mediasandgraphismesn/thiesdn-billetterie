        target_content: "  const [connectionSaved, setConnectionSaved] = useState(false);\n  const isConnected = isSupabaseConfigured();"
        replacement_content: "  const [connectionSaved, setConnectionSaved] = useState(false);\n  const [isTestingSupabase, setIsTestingSupabase] = useState(false);\n  const [testResult, setTestResult] = useState<{\n    success: boolean;\n    message: string;\n    events: any[];\n    error?: string;\n  } | null>(null);\n\n  const isConnected = isSupabaseConfigured();\n\n  const handleTestSupabaseLive = async () => {\n    setIsTestingSupabase(true);\n    setTestResult(null);\n\n    const client = getSupabaseClient();\n    if (!client) {\n      setTestResult({\n        success: false,\n        message: \'Cl\303\251s Supabase manquantes ou non valides.\',\n        events: [],\n        error: \'Veuillez renseigner VITE_SUPABASE_URL et VITE_SUPABASE_ANON_KEY.\',\n      });\n      setIsTestingSupabase(false);\n      return;\n    }\n\n    try {\n      // 1. Tenter la requ\303\252te sur \"events\" avec status = \'approved\'\n      const { data, error } = await client\n        .from(\'events\')\n        .select(\'*\')\n        .eq(\'status\', \'approved\');\n\n      if (error) {\n        setTestResult({\n          success: false,\n          message: `Erreur Supabase: ${error.message}`,\n          events: [],\n          error: error.message.includes(\'relation \"public.events\" does not exist\') || error.code === \'PGRST205\'\n            ? \'La table \"events\" n\\\'existe pas encore dans votre base Supabase. Utilisez le bouton \"Copier SQL\" ci-dessous et ex\303\251cutez le script dans le SQL Editor de Supabase.\'\n            : error.message,\n        });\n      } else {\n        let eventsList = data || [];\n\n        // 2. Si vide, ins\303\251rer 2 \303\251v\303\251nements de test\n        if (eventsList.length === 0) {\n          const testEvents = [\n            {\n              title: \'Nuit du Baobab Prestige - Thi\303\250s\',\n              category: \'nightlife\',\n              description: \'Soir\303\251e exceptionnelle au Grand Th\303\251\303\242tre de Thi\303\250s avec les plus grands artistes\',\n              venue: \'Grand Th\303\251\303\242tre de Thi\303\250s, Thi\303\250s, S\303\251n\303\251gal\',\n              city: \'Thi\303\250s\',\n              poster_url: \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800\',\n              promoter_name: \'Promoteur Test Thi\303\250s\',\n              price: 5000,\n              status: \'approved\',\n              date: \'25 Octobre 2024\',\n              time: \'21:30\',\n              datetime_iso: \'2024-10-25T21:30:00Z\',\n            },\n            {\n              title: \'Mbour Afro-Fusion & Mbalax Live\',\n              category: \'concert\',\n              description: \'Soir\303\251e Afro-Fusion au Mbour Night Lounge avec les meilleurs DJ\',\n              venue: \'Mbour Night Lounge, Bord de Mer, Mbour\',\n              city: \'Mbour\',\n              poster_url: \'https://images.unsplash.com/photo-1506157786151-b8491531f063?w=800\',\n              promoter_name: \'Promoteur Test Mbour\',\n              price: 3000,\n              status: \'approved\',\n              date: \'28 Octobre 2024\',\n              time: \'22:00\',\n              datetime_iso: \'2024-10-28T22:00:00Z\',\n            },\n          ];\n\n          const { data: inserted, error: insertError } = await client\n            .from(\'events\')\n            .insert(testEvents)\n            .select();\n\n          if (insertError) {\n            setTestResult({\n              success: false,\n              message: `Table trouv\303\251e mais erreur d\'insertion: ${insertError.message}`,\n              events: [],\n              error: insertError.message,\n            });\n          } else {\n            eventsList = inserted || testEvents;\n            setTestResult({\n              success: true,\n              message: `\342\234\205 Connexion Supabase r\303\251ussie ! ${eventsList.length} \303\251v\303\251nements cr\303\251\303\251s et trouv\303\251s.`,\n              events: eventsList,\n            });\n          }\n        } else {\n          setTestResult({\n            success: true,\n            message: `\342\234\205 Connexion Supabase r\303\251ussie ! ${eventsList.length} \303\251v\303\251nements trouv\303\251s`,\n            events: eventsList,\n          });\n        }\n      }\n    } catch (err: any) {\n      setTestResult({\n        success: false,\n        message: \'Erreur inattendue de connexion r\303\251seau.\',\n        events: [],\n        error: err.message,\n      });\n    } finally {\n      setIsTestingSupabase(false);\n    }\n  };"
      }
      num_matches: 1
    }
  }
