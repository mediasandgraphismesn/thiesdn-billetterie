  file_change {
    absolute_path_uri: "file:///src/components/Sidebar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport {\n  LayoutDashboard,\n  Compass,\n  Ticket,\n  ShieldCheck,\n  QrCode,\n  Settings,\n  PlusCircle,\n  Sparkles,\n  Crown,\n  CheckCircle2,\n  Wallet,\n  Database,\n} from \'lucide-react\';\nimport { UserProfile } from \'../types\';\n\ninterface SidebarProps {\n  user: UserProfile;\n  activeTab: string;\n  onTabChange: (tab: string) => void;\n  onOpenCreateModal: () => void;\n  pendingModerationCount: number;\n  totalEventsCount: number;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  user,\n  activeTab,\n  onTabChange,\n  onOpenCreateModal,\n  pendingModerationCount,\n  totalEventsCount,\n}) => {\n  const navItems = [\n    { id: \'home\', label: \'Accueil / \303\211v\303\251nements\', icon: LayoutDashboard, badge: totalEventsCount },\n    { id: \'explore\', label: \'Explorer la Carte\', icon: Compass },\n    { id: \'tickets\', label: \'Mes Billets & Pass VIP\', icon: Ticket },\n    {\n      id: \'moderation\',\n      label: \'Hub Mod\303\251ration\',\n      icon: ShieldCheck,\n      badge: pendingModerationCount > 0 ? `${pendingModerationCount} en attente` : undefined,\n      badgeStyle: \'bg-[#E9C349]/20 text-[#E9C349] border border-[#E9C349]/30\',\n    },\n    { id: \'checkin\', label: \'Scanner & Check-in\', icon: QrCode },\n    { id: \'finances\', label: \'Finances & Supabase\', icon: Wallet, badge: \'90/10 Split\', badgeStyle: \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\' },\n    { id: \'profile\', label: \'Profil & Param\303\250tres\', icon: Settings },\n  ];\n\n  return (\n    <aside className=\"hidden lg:flex flex-col fixed inset-y-0 left-0 z-40 w-72 bg-[#1C1B1B]/95 backdrop-blur-2xl border-r border-white/10 p-5 shadow-2xl\">\n      {/* Promoter Hub Profile Badge */}\n      <div className=\"p-4 rounded-2xl bg-gradient-to-br from-[#201F1F] to-[#141414] border border-white/10 mb-6 relative overflow-hidden\">\n        <div className=\"absolute top-0 right-0 w-24 h-24 bg-[#8A2BE2]/10 rounded-full blur-2xl pointer-events-none\" />\n        \n        <div className=\"flex items-center gap-3 relative z-10\">\n          <div className=\"relative\">\n            <div className=\"w-12 h-12 rounded-full overflow-hidden border-2 border-[#E9C349] shadow-md\">\n              <img\n                src={user.avatar}\n                alt={user.name}\n                className=\"w-full h-full object-cover\"\n              />\n            </div>\n            <div className=\"absolute -bottom-1 -right-1 bg-[#8A2BE2] p-1 rounded-full text-white\">\n              <Sparkles className=\"w-3 h-3\" />\n            </div>\n          </div>\n\n          <div className=\"flex-1 min-w-0\">\n            <div className=\"flex items-center gap-1.5\">\n              <h2 className=\"font-heading text-sm font-bold text-white truncate\">\n                {user.username}\n              </h2>\n            </div>\n            <p className=\"text-xs text-[#E9C349] font-medium flex items-center gap-1\">\n              <Crown className=\"w-3 h-3\" />\n              VIP Promoter Hub\n            </p>\n          </div>\n        </div>\n\n        <div className=\"mt-3 pt-2.5 border-t border-white/10 flex items-center justify-between text-[11px] text-gray-400\">\n          <span className=\"flex items-center gap-1 text-[#DCB8FF]\">\n            <CheckCircle2 className=\"w-3.5 h-3.5\" /> Compte S\303\251n\303\251gal\n          </span>\n          <span className=\"bg-[#8A2BE2]/20 text-[#DCB8FF] px-2 py-0.5 rounded-full font-bold\">\n            Thiesdn VIP\n          </span>\n        </div>\n      </div>\n\n      {/* Primary Action Button */}\n      <button\n        onClick={onOpenCreateModal}\n        className=\"w-full mb-6 btn-primary-glow py-3 px-4 rounded-xl flex items-center justify-center gap-2 font-heading font-bold text-xs tracking-wider uppercase transition-all\"\n      >\n        <PlusCircle className=\"w-4 h-4\" />\n        Cr\303\251er un \303\211v\303\251nement\n      </button>\n\n      {/* Navigation Links */}\n      <nav className=\"flex-1 space-y-1.5 overflow-y-auto\">\n        <p className=\"text-[11px] uppercase tracking-wider text-gray-400 font-bold px-3 mb-2\">\n          Navigation\n        </p>\n        {navItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = activeTab === item.id;\n\n          return (\n            <button\n              key={item.id}\n              onClick={() => onTabChange(item.id)}\n              className={`w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-sm font-medium transition-all text-left ${\n                isActive\n                  ? \'bg-gradient-to-r from-[#8A2BE2]/30 to-[#8A2BE2]/10 text-white border border-[#8A2BE2]/40 font-semibold shadow-inner\'\n                  : \'text-[#CFC2D7] hover:bg-white/5 hover:text-white\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <Icon className={`w-4 h-4 ${isActive ? \'text-[#DCB8FF]\' : \'text-gray-400\'}`} />\n                <span>{item.label}</span>\n              </div>\n              {item.badge && (\n                <span\n                  className={`text-[11px] font-bold px-2 py-0.5 rounded-full ${\n                    item.badgeStyle || \'bg-white/10 text-gray-300\'\n                  }`}\n                >\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Footer System Status */}\n      <div className=\"pt-4 border-t border-white/10\">\n        <div className=\"p-3 rounded-xl bg-black/40 border border-white/5 flex items-center justify-between text-xs\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n            <span className=\"text-gray-300 font-medium\">Billetterie Live SN</span>\n          </div>\n          <span className=\"text-[10px] text-gray-400\">Thi\303\250s \342\200\242 Dakar</span>\n        </div>\n      </div>\n    </aside>\n  );\n};\n"
    }
