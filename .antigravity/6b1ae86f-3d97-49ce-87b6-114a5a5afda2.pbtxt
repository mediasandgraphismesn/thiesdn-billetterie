  file_change {
    absolute_path_uri: "file:///src/components/EventDetailModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  X,\n  Calendar,\n  MapPin,\n  Clock,\n  ShieldCheck,\n  Sparkles,\n  Crown,\n  Share2,\n  Heart,\n  CreditCard,\n  Smartphone,\n  CheckCircle2,\n  MessageSquare,\n  Play,\n  Flame,\n  Info,\n  Check,\n} from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { EventItem, TicketTier, UserTicket } from \'../types\';\nimport { saveTransaction, calculateCommissionSplit } from \'../services/supabase\';\n\ninterface EventDetailModalProps {\n  event: EventItem | null;\n  isOpen: boolean;\n  onClose: () => void;\n  onPurchaseSuccess: (ticket: UserTicket) => void;\n  userName: string;\n}\n\nexport const EventDetailModal: React.FC<EventDetailModalProps> = ({\n  event,\n  isOpen,\n  onClose,\n  onPurchaseSuccess,\n  userName,\n}) => {\n  if (!isOpen || !event) return null;\n\n  const defaultTier: TicketTier = event.tiers?.[0] || {\n    id: \'t-default\',\n    name: \'Billet Standard\',\n    price: event.price,\n    description: \'Acc\303\250s r\303\251gulier \303\240 l\342\200\231\303\251v\303\251nement\',\n    perks: [\'Entr\303\251e garantie\', \'Acc\303\250s piste\'],\n    available: 100,\n  };\n\n  const [selectedTier, setSelectedTier] = useState<TicketTier>(defaultTier);\n  const [quantity, setQuantity] = useState(1);\n  const [paymentMethod, setPaymentMethod] = useState<\'wave\' | \'om\' | \'yas\' | \'card\'>(\'wave\');\n  const [phoneNumber, setPhoneNumber] = useState(\'77 123 45 67\');\n  const [isProcessing, setIsProcessing] = useState(false);\n  const [isLiked, setIsLiked] = useState(false);\n\n  const tiers = event.tiers && event.tiers.length > 0 ? event.tiers : [defaultTier];\n  const totalPrice = selectedTier.price * quantity;\n  const split = calculateCommissionSplit(totalPrice);\n\n  const handleCheckout = () => {\n    setIsProcessing(true);\n\n    setTimeout(() => {\n      setIsProcessing(false);\n\n      // Trigger celebration confetti\n      try {\n        confetti({\n          particleCount: 80,\n          spread: 70,\n          origin: { y: 0.6 },\n          colors: [\'#8A2BE2\', \'#E9C349\', \'#DCB8FF\', \'#FFFFFF\', \'#00d2ff\'],\n        });\n      } catch (e) {\n        // Safe fallback\n      }\n\n      const ticketId = `tkt-thiesdn-${Date.now().toString().slice(-6)}`;\n      const qrCode = `THIESDN-${event.city.toUpperCase()}-${selectedTier.name.toUpperCase().replace(/\\s+/g, \'-\')}-${Math.floor(1000 + Math.random() * 9000)}`;\n\n      const newTicket: UserTicket = {\n        id: ticketId,\n        eventId: event.id,\n        eventTitle: event.title,\n        eventPoster: event.posterUrl,\n        eventDate: event.date,\n        eventTime: event.time,\n        eventVenue: event.venue,\n        tierName: selectedTier.name,\n        price: totalPrice,\n        qrCode,\n        seatNumber: selectedTier.name.toLowerCase().includes(\'vip\') || selectedTier.name.toLowerCase().includes(\'table\') \n          ? `VIP Zone ${event.city}` \n          : `Placement Libre (${event.city})`,\n        holderName: userName || \'Alexandre Diop\',\n        purchasedAt: new Date().toISOString(),\n        status: \'valid\',\n      };\n\n      // Record transaction with automatic commission split\n      saveTransaction({\n        id: `tx-${Date.now().toString().slice(-6)}`,\n        ticketId,\n        eventId: event.id,\n        eventTitle: event.title,\n        promoterId: event.promoter.id,\n        promoterName: event.promoter.name,\n        customerName: userName || \'Alexandre Diop\',\n        customerPhone: `+221 ${phoneNumber}`,\n        paymentMethod,\n        totalAmount: totalPrice,\n        promoterShare: split.promoterShare,\n        platformFee: split.platformFee,\n        operatorFee: split.operatorFee,\n        status: \'completed\',\n        createdAt: new Date().toISOString(),\n      });\n\n      onPurchaseSuccess(newTicket);\n      onClose();\n    }, 1200);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md overflow-y-auto animate-in fade-in duration-200\">\n      <div className=\"relative w-full max-w-2xl bg-[#171717] border border-white/10 rounded-3xl overflow-hidden shadow-2xl my-8 max-h-[90vh] flex flex-col\">\n        {/* Poster Header */}\n        <div className=\"relative h-64 sm:h-72 w-full flex-shrink-0\">\n          <img\n            src={event.posterUrl}\n            alt={event.title}\n            className=\"w-full h-full object-cover\"\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-[#171717] via-black/40 to-transparent\" />\n\n          {/* Top Controls */}\n          <div className=\"absolute top-4 inset-x-4 flex items-center justify-between z-10\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"bg-[#1C1B1B]/80 backdrop-blur-md text-[#E9C349] border border-[#E9C349]/30 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-lg flex items-center gap-1.5\">\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                {event.category}\n              </span>\n              <span className=\"bg-[#8A2BE2]/90 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg\">\n                \360\237\223\215 {event.city}\n              </span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={() => setIsLiked(!isLiked)}\n                className=\"w-9 h-9 rounded-full bg-black/60 backdrop-blur-md text-white hover:text-red-400 flex items-center justify-center border border-white/10 transition-colors\"\n              >\n                <Heart className={`w-4 h-4 ${isLiked ? \'fill-red-500 text-red-500\' : \'\'}`} />\n              </button>\n              <button\n                onClick={onClose}\n                className=\"w-9 h-9 rounded-full bg-black/60 backdrop-blur-md text-white hover:bg-white/20 flex items-center justify-center border border-white/10 transition-colors\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Event Title on Poster */}\n          <div className=\"absolute bottom-4 inset-x-6 z-10\">\n            {event.isExclusive && (\n              <span className=\"bg-[#E9C349] text-[#241A00] text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full mb-1.5 inline-block\">\n                \342\230\205 Soir\303\251e Exclusive Prestige\n              </span>\n            )}\n            <h2 className=\"font-heading text-2xl sm:text-3xl font-extrabold text-white leading-tight\">\n              {event.title}\n            </h2>\n          </div>\n        </div>\n\n        {/* Scrollable Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-6 flex-1\">\n          {/* Metadata Grid */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 bg-[#201F1F] p-4 rounded-2xl border border-white/5\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-[#8A2BE2]/20 text-[#DCB8FF] flex items-center justify-center flex-shrink-0\">\n                <Calendar className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <p className=\"text-[11px] uppercase tracking-wider text-gray-400 font-bold\">Date & Heure</p>\n                <p className=\"text-sm font-semibold text-white\">{event.date} \342\200\242 {event.time}</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 rounded-xl bg-[#E9C349]/20 text-[#E9C349] flex items-center justify-center flex-shrink-0\">\n                <MapPin className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <p className=\"text-[11px] uppercase tracking-wider text-gray-400 font-bold\">Lieu & R\303\251gion</p>\n                <p className=\"text-sm font-semibold text-white truncate\">{event.venue}, {event.city}</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Description */}\n          {event.description && (\n            <div>\n              <h3 className=\"font-heading text-sm font-bold text-white uppercase tracking-wider mb-2\">\n                \303\200 propos de l\342\200\231\303\251v\303\251nement\n              </h3>\n              <p className=\"text-sm text-gray-300 leading-relaxed bg-[#201F1F]/60 p-4 rounded-2xl border border-white/5\">\n                {event.description}\n              </p>\n            </div>\n          )}\n\n          {/* Promoter Info */}\n          <div className=\"flex items-center justify-between p-3.5 bg-[#201F1F] rounded-2xl border border-white/5\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={event.promoter.avatar}\n                alt={event.promoter.name}\n                className=\"w-11 h-11 rounded-full object-cover border border-[#E9C349]/50\"\n              />\n              <div>\n                <div className=\"flex items-center gap-1.5\">\n                  <p className=\"text-sm font-bold text-white\">{event.promoter.name}</p>\n                  {event.promoter.verified && (\n                    <ShieldCheck className=\"w-4 h-4 text-[#8A2BE2]\" />\n                  )}\n                </div>\n                <p className=\"text-xs text-gray-400\">{event.promoter.role || \'Organisateur Officiel\'}</p>\n              </div>\n            </div>\n\n            {event.whatsappContact && (\n              <a\n                href={`https://wa.me/${event.whatsappContact.replace(/[^0-9]/g, \'\')}`}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"flex items-center gap-1.5 bg-[#25D366]/20 hover:bg-[#25D366] text-[#25D366] hover:text-white px-3 py-1.5 rounded-xl text-xs font-bold transition-all border border-[#25D366]/30\"\n              >\n                <MessageSquare className=\"w-3.5 h-3.5\" />\n                WhatsApp\n              </a>\n            )}\n          </div>\n\n          {/* Select Ticket Tier */}\n          <div>\n            <div className=\"flex items-center justify-between mb-3\">\n              <h3 className=\"font-heading text-sm font-bold text-white uppercase tracking-wider\">\n                Choisir une Formule de Billet\n              </h3>\n              <span className=\"text-xs text-[#DCB8FF] font-semibold\">\n                {tiers.length} formule(s) disponible(s)\n              </span>\n            </div>\n\n            <div className=\"space-y-2.5\">\n              {tiers.map((tier) => {\n                const isSelected = selectedTier.id === tier.id;\n                const isVipTier = tier.name.toLowerCase().includes(\'vip\') || tier.name.toLowerCase().includes(\'table\') || tier.name.toLowerCase().includes(\'baobab\');\n\n                return (\n                  <div\n                    key={tier.id}\n                    onClick={() => setSelectedTier(tier)}\n                    className={`p-4 rounded-2xl cursor-pointer transition-all border ${\n                      isSelected\n                        ? isVipTier\n                          ? \'bg-[#241A00]/80 border-[#E9C349] shadow-lg shadow-[#E9C349]/15\'\n                          : \'bg-[#8A2BE2]/20 border-[#8A2BE2] shadow-lg shadow-[#8A2BE2]/20\'\n                        : \'bg-[#201F1F] border-white/5 hover:border-white/20\'\n                    }`}\n                  >\n                    <div className=\"flex items-start justify-between\">\n                      <div>\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"font-heading font-bold text-sm text-white\">\n                            {tier.name}\n                          </span>\n                          {isVipTier && (\n                            <span className=\"bg-[#E9C349] text-[#241A00] text-[9px] font-extrabold px-2 py-0.5 rounded-full flex items-center gap-0.5\">\n                              <Crown className=\"w-2.5 h-2.5\" /> VIP\n                            </span>\n                          )}\n                        </div>\n                        <p className=\"text-xs text-gray-400 mt-0.5\">{tier.description}</p>\n                      </div>\n\n                      <div className=\"text-right\">\n                        <span className=\"font-heading font-extrabold text-base text-[#E9C349]\">\n                          {tier.price.toLocaleString(\'fr-FR\')} FCFA\n                        </span>\n                        <p className=\"text-[10px] text-gray-400\">par personne</p>\n                      </div>\n                    </div>\n\n                    {/* Perks list */}\n                    {tier.perks && tier.perks.length > 0 && (\n                      <div className=\"mt-2.5 pt-2 border-t border-white/10 flex flex-wrap gap-1.5\">\n                        {tier.perks.map((perk, idx) => (\n                          <span\n                            key={idx}\n                            className=\"bg-white/5 text-gray-300 text-[11px] px-2 py-0.5 rounded-md flex items-center gap-1\"\n                          >\n                            <CheckCircle2 className=\"w-3 h-3 text-[#DCB8FF]\" />\n                            {perk}\n                          </span>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Quantity selector */}\n          <div className=\"flex items-center justify-between p-4 bg-[#201F1F] rounded-2xl border border-white/5\">\n            <div>\n              <p className=\"text-xs uppercase tracking-wider text-gray-400 font-bold\">Nombre de places</p>\n              <p className=\"text-sm font-semibold text-white\">Billet individuel ou groupe (Max 6)</p>\n            </div>\n            <div className=\"flex items-center gap-3 bg-[#131313] p-1 rounded-xl border border-white/10\">\n              <button\n                onClick={() => setQuantity(Math.max(1, quantity - 1))}\n                className=\"w-8 h-8 rounded-lg bg-[#242424] hover:bg-[#333] text-white flex items-center justify-center font-bold text-base transition-colors\"\n              >\n                -\n              </button>\n              <span className=\"font-heading font-bold text-base text-white px-2\">\n                {quantity}\n              </span>\n              <button\n                onClick={() => setQuantity(Math.min(6, quantity + 1))}\n                className=\"w-8 h-8 rounded-lg bg-[#242424] hover:bg-[#333] text-white flex items-center justify-center font-bold text-base transition-colors\"\n              >\n                +\n              </button>\n            </div>\n          </div>\n\n          {/* Mobile Money Payment Methods in Senegal (Wave, Orange Money, YAS) */}\n          <div>\n            <h3 className=\"font-heading text-xs font-bold text-gray-400 uppercase tracking-wider mb-2.5 flex items-center justify-between\">\n              <span>Paiement Mobile Money S\303\251n\303\251gal</span>\n              <span className=\"text-[10px] text-emerald-400\">Instantan\303\251 & S\303\251curis\303\251</span>\n            </h3>\n            \n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3\">\n              {[\n                { id: \'wave\', label: \'Wave\', color: \'text-sky-400 border-sky-400/50 bg-sky-500/10\' },\n                { id: \'om\', label: \'Orange Money\', color: \'text-orange-400 border-orange-400/50 bg-orange-500/10\' },\n                { id: \'yas\', label: \'YAS (Free)\', color: \'text-emerald-400 border-emerald-400/50 bg-emerald-500/10\' },\n                { id: \'card\', label: \'Carte Bancaire\', color: \'text-[#DCB8FF] border-[#8A2BE2]/50 bg-[#8A2BE2]/10\' },\n              ].map((m) => (\n                <button\n                  key={m.id}\n                  onClick={() => setPaymentMethod(m.id as any)}\n                  className={`p-3 rounded-xl border text-xs font-bold transition-all text-center ${\n                    paymentMethod === m.id\n                      ? `${m.color} ring-2 ring-[#8A2BE2]`\n                      : \'bg-[#201F1F] border-white/5 text-gray-400 hover:border-white/20\'\n                  }`}\n                >\n                  {m.label}\n                </button>\n              ))}\n            </div>\n\n            {/* Mobile Money Phone Input */}\n            {(paymentMethod === \'wave\' || paymentMethod === \'om\' || paymentMethod === \'yas\') && (\n              <div className=\"bg-[#1C1B1B] p-3.5 rounded-2xl border border-white/5 flex items-center gap-3\">\n                <div className=\"px-2.5 py-1.5 rounded-lg bg-black/40 text-xs font-bold text-[#E9C349] border border-white/5\">\n                  \360\237\207\270\360\237\207\263 +221\n                </div>\n                <input\n                  type=\"tel\"\n                  value={phoneNumber}\n                  onChange={(e) => setPhoneNumber(e.target.value)}\n                  placeholder=\"77 XXX XX XX\"\n                  className=\"bg-transparent border-none outline-none text-white text-sm font-mono flex-1 focus:ring-0 p-0\"\n                />\n                <span className=\"text-[11px] text-gray-400\">Push confirmation</span>\n              </div>\n            )}\n\n            {/* Commission Split Transparency preview */}\n            <div className=\"mt-3 p-3 bg-black/40 rounded-xl border border-white/5 text-[11px] text-gray-400 flex flex-wrap items-center justify-between gap-2\">\n              <span>Reversement promoteur: <strong className=\"text-white\">{split.promoterShare.toLocaleString(\'fr-FR\')} F (90%)</strong></span>\n              <span>Frais Thiesdn: <strong className=\"text-[#DCB8FF]\">{split.platformFee.toLocaleString(\'fr-FR\')} F (10%)</strong></span>\n              <span>Op\303\251rateur: <strong className=\"text-sky-400\">{split.operatorFee.toLocaleString(\'fr-FR\')} F (1%)</strong></span>\n            </div>\n          </div>\n        </div>\n\n        {/* Footer Checkout Sticky Bar */}\n        <div className=\"p-5 bg-[#141414] border-t border-white/10 flex items-center justify-between gap-4\">\n          <div>\n            <p className=\"text-[11px] uppercase tracking-wider text-gray-400 font-bold\">Total TTC</p>\n            <p className=\"font-heading text-xl sm:text-2xl font-extrabold text-[#E9C349]\">\n              {totalPrice.toLocaleString(\'fr-FR\')} FCFA\n            </p>\n          </div>\n\n          <button\n            onClick={handleCheckout}\n            disabled={isProcessing}\n            className=\"btn-primary-glow flex-1 max-w-xs py-3.5 px-6 rounded-2xl font-heading font-bold text-sm tracking-wider uppercase flex items-center justify-center gap-2 transition-all disabled:opacity-50\"\n          >\n            {isProcessing ? (\n              <div className=\"flex items-center gap-2\">\n                <span className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                <span>Paiement {paymentMethod.toUpperCase()}...</span>\n              </div>\n            ) : (\n              <>\n                <Smartphone className=\"w-4 h-4\" />\n                <span>Payer avec {paymentMethod === \'om\' ? \'Orange Money\' : paymentMethod === \'yas\' ? \'YAS\' : paymentMethod.toUpperCase()}</span>\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
