    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  ArrowLeft,\n  Info,\n  MapPin,\n  Image as ImageIcon,\n  Link,\n  Phone,\n  CheckCircle2,\n  Sparkles,\n  Upload,\n  Calendar,\n  DollarSign,\n  Compass,\n} from \'lucide-react\';\nimport { EventItem, EventCategory } from \'../types\';\n\ninterface CreateEventViewProps {\n  onEventCreated: (newEvent: EventItem) => void;\n  onBack: () => void;\n  promoterName?: string;\n  promoterAvatar?: string;\n}\n\nconst PRESET_POSTERS = [\n  {\n    name: \'Gala Prestige Thi\303\250s\',\n    url: \'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    name: \'Saly Beach Festival\',\n    url: \'https://images.unsplash.com/photo-1533105079780-92b9be482077?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    name: \'Afro Vibes & Mbalax Live\',\n    url: \'https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    name: \'Neon Laser Night Dakar\',\n    url: \'https://images.unsplash.com/photo-1540039155733-5bb30b53aa14?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    name: \'Jazz & Lounge Prestige\',\n    url: \'https://images.unsplash.com/photo-1511192336575-5a79af67a629?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    name: \'Open Air Urban Sound\',\n    url: \'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=1200&auto=format&fit=crop\',\n  },\n];\n\nexport const CreateEventView: React.FC<CreateEventViewProps> = ({\n  onEventCreated,\n  onBack,\n  promoterName = \'Lat Dior Productions\',\n  promoterAvatar = \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop\',\n}) => {\n  const [title, setTitle] = useState(\'\');\n  const [category, setCategory] = useState<EventCategory>(\'Gala\');\n  const [startDatetime, setStartDatetime] = useState(\'2024-11-20T21:30\');\n  const [endDatetime, setEndDatetime] = useState(\'\');\n  const [venue, setVenue] = useState(\'\');\n  const [city, setCity] = useState(\'Thi\303\250s\');\n  const [posterUrl, setPosterUrl] = useState(PRESET_POSTERS[0].url);\n  const [youtubeUrl, setYoutubeUrl] = useState(\'\');\n  const [price, setPrice] = useState<number>(20000);\n  const [whatsappContact, setWhatsappContact] = useState(\'+221 77 890 12 34\');\n  const [description, setDescription] = useState(\'\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [showSuccessToast, setShowSuccessToast] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!title.trim()) {\n      alert(\'Veuillez entrer un titre pour l\342\200\231\303\251v\303\251nement.\');\n      return;\n    }\n\n    setIsSubmitting(true);\n\n    const dateObj = new Date(startDatetime);\n    const formattedDate = dateObj.toLocaleDateString(\'fr-FR\', {\n      day: \'numeric\',\n      month: \'long\',\n      year: \'numeric\',\n    });\n    const formattedTime = dateObj.toLocaleTimeString(\'fr-FR\', {\n      hour: \'2-digit\',\n      minute: \'2-digit\',\n    });\n\n    const newEvent: EventItem = {\n      id: `evt-${city.toLowerCase()}-${Date.now().toString().slice(-5)}`,\n      title,\n      category,\n      date: formattedDate || \'20 Novembre 2024\',\n      time: formattedTime || \'21:30\',\n      datetimeIso: startDatetime,\n      venue: venue || `Salle Prestige, ${city}`,\n      city: city || \'Thi\303\250s\',\n      posterUrl: posterUrl || PRESET_POSTERS[0].url,\n      price: Number(price) || 10000,\n      priceLabel: `${Number(price).toLocaleString(\'fr-FR\')} FCFA`,\n      featured: false,\n      status: \'pending\', // Sent to moderation queue\n      vipAvailable: true,\n      description: description || `\303\211v\303\251nement haut de gamme \303\240 ${city} organis\303\251 avec Thiesdn Billetterie.`,\n      youtubeUrl,\n      whatsappContact,\n      promoter: {\n        id: \'prom-me\',\n        name: promoterName,\n        avatar: promoterAvatar,\n        verified: true,\n        role: `Promoteur ${city}`,\n      },\n      tiers: [\n        {\n          id: \'t-std\',\n          name: `Pass Standard ${city}`,\n          price: Number(price) || 10000,\n          description: \'Acc\303\250s r\303\251gulier \303\240 l\342\200\231\303\251v\303\251nement\',\n          perks: [\'Entr\303\251e garantie\', \'1 Boisson offerte\'],\n          available: 100,\n        },\n        {\n          id: \'t-vip\',\n          name: `Pass VIP ${city} Prestige`,\n          price: (Number(price) || 10000) * 2,\n          description: \'Acc\303\250s VIP coupe-file & cocktail de bienvenue\',\n          perks: [\'Acc\303\250s prioritaire\', \'Coupe de champagne\', \'Service table\'],\n          available: 25,\n        },\n      ],\n      createdAt: new Date().toISOString(),\n    };\n\n    setTimeout(() => {\n      setIsSubmitting(false);\n      setShowSuccessToast(true);\n      onEventCreated(newEvent);\n\n      setTimeout(() => {\n        onBack();\n      }, 1400);\n    }, 600);\n  };\n\n  return (\n    <div className=\"max-w-3xl mx-auto pb-16 animate-in fade-in duration-300\">\n      {/* Header Bar */}\n      <div className=\"flex items-center justify-between mb-6\">\n        <button\n          onClick={onBack}\n          className=\"flex items-center gap-2 text-sm text-[#CFC2D7] hover:text-white transition-colors\"\n        >\n          <ArrowLeft className=\"w-5 h-5\" />\n          <span>Retour</span>\n        </button>\n        <span className=\"text-xs font-bold text-[#E9C349] uppercase tracking-wider bg-[#241A00] px-3 py-1 rounded-full border border-[#E9C349]/30\">\n          Studio Promoteur S\303\251n\303\251gal\n        </span>\n      </div>\n\n      <div className=\"mb-8\">\n        <h1 className=\"font-heading text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n          Cr\303\251er un \303\211v\303\251nement\n        </h1>\n        <p className=\"text-sm text-gray-400 mt-1\">\n          Soumettez votre \303\251v\303\251nement \303\240 Thi\303\250s, Mbour, Saly ou Dakar pour mod\303\251ration et vente avec Mobile Money.\n        </p>\n      </div>\n\n      {showSuccessToast && (\n        <div className=\"mb-6 p-4 rounded-2xl bg-emerald-950/80 border border-emerald-500/50 text-emerald-200 flex items-center gap-3 animate-in fade-in slide-in-from-top duration-300\">\n          <CheckCircle2 className=\"w-6 h-6 text-emerald-400 flex-shrink-0\" />\n          <div>\n            <p className=\"font-bold text-sm\">\303\211v\303\251nement enregistr\303\251 avec succ\303\250s !</p>\n            <p className=\"text-xs text-emerald-300/80\">\n              Votre \303\251v\303\251nement a \303\251t\303\251 transmis \303\240 la file de mod\303\251ration administrative.\n            </p>\n          </div>\n        </div>\n      )}\n\n      <form onSubmit={handleSubmit} className=\"space-y-6\">\n        {/* Basic Information Section */}\n        <section className=\"bg-[#1F1F1F] rounded-2xl p-6 border border-white/10 relative overflow-hidden space-y-4\">\n          <div className=\"flex items-center gap-2 text-[#DCB8FF] font-heading font-bold text-base border-b border-white/10 pb-3\">\n            <Info className=\"w-5 h-5\" />\n            <span>Informations G\303\251n\303\251rales</span>\n          </div>\n\n          {/* Event Title */}\n          <div className=\"flex flex-col gap-1.5\">\n            <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n              Titre de l\'\303\251v\303\251nement\n            </label>\n            <div className=\"input-glass rounded-xl px-4 py-3\">\n              <input\n                type=\"text\"\n                required\n                value={title}\n                onChange={(e) => setTitle(e.target.value)}\n                placeholder=\"Ex: Nuit du Rail Thi\303\250s & Mbalax Live\"\n                className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0\"\n              />\n            </div>\n          </div>\n\n          {/* Category & City */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n                Cat\303\251gorie\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3\">\n                <select\n                  value={category}\n                  onChange={(e) => setCategory(e.target.value as EventCategory)}\n                  className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0 cursor-pointer\"\n                >\n                  <option value=\"Gala\" className=\"bg-[#1F1F1F]\">Gala & Prestige</option>\n                  <option value=\"Concert\" className=\"bg-[#1F1F1F]\">Concert & Mbalax</option>\n                  <option value=\"Festival\" className=\"bg-[#1F1F1F]\">Festival & Open Air</option>\n                  <option value=\"Bo\303\256te de nuit\" className=\"bg-[#1F1F1F]\">Bo\303\256te de nuit & Clubbing</option>\n                  <option value=\"VIP Lounge\" className=\"bg-[#1F1F1F]\">VIP Lounge</option>\n                  <option value=\"Piscine\" className=\"bg-[#1F1F1F]\">Piscine & Beach Party</option>\n                  <option value=\"After-work\" className=\"bg-[#1F1F1F]\">After-work & Networking</option>\n                  <option value=\"Culture\" className=\"bg-[#1F1F1F]\">Culture & Th\303\251\303\242tre</option>\n                </select>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n                Ville / R\303\251gion S\303\251n\303\251gal\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3\">\n                <select\n                  value={city}\n                  onChange={(e) => setCity(e.target.value)}\n                  className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0 cursor-pointer font-bold text-[#E9C349]\"\n                >\n                  <option value=\"Thi\303\250s\" className=\"bg-[#1F1F1F]\">\360\237\223\215 Thi\303\250s</option>\n                  <option value=\"Mbour\" className=\"bg-[#1F1F1F]\">\360\237\223\215 Mbour</option>\n                  <option value=\"Saly\" className=\"bg-[#1F1F1F]\">\360\237\223\215 Saly Portudal</option>\n                  <option value=\"Dakar\" className=\"bg-[#1F1F1F]\">\360\237\223\215 Dakar</option>\n                </select>\n              </div>\n            </div>\n          </div>\n\n          {/* Date & Time Row */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n                Date & Heure de D\303\251but\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3\">\n                <input\n                  type=\"datetime-local\"\n                  value={startDatetime}\n                  onChange={(e) => setStartDatetime(e.target.value)}\n                  className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0 [color-scheme:dark]\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n                Fin (Optionnel)\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3\">\n                <input\n                  type=\"datetime-local\"\n                  value={endDatetime}\n                  onChange={(e) => setEndDatetime(e.target.value)}\n                  className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0 [color-scheme:dark]\"\n                />\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Location Section */}\n        <section className=\"bg-[#1F1F1F] rounded-2xl p-6 border border-white/10 space-y-4\">\n          <div className=\"flex items-center gap-2 text-[#DCB8FF] font-heading font-bold text-base border-b border-white/10 pb-3\">\n            <MapPin className=\"w-5 h-5 text-[#E9C349]\" />\n            <span>Lieu & Adresse \303\240 {city}</span>\n          </div>\n\n          <div className=\"flex flex-col gap-1.5\">\n            <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n              Nom de la salle, h\303\264tel ou plage\n            </label>\n            <div className=\"input-glass rounded-xl px-4 py-3 flex items-center gap-2\">\n              <MapPin className=\"w-4 h-4 text-gray-400\" />\n              <input\n                type=\"text\"\n                required\n                value={venue}\n                onChange={(e) => setVenue(e.target.value)}\n                placeholder={`Ex: Grand Th\303\251\303\242tre de ${city}, Esplanade`}\n                className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0\"\n              />\n            </div>\n          </div>\n        </section>\n\n        {/* Media & Poster Section */}\n        <section className=\"bg-[#1F1F1F] rounded-2xl p-6 border border-white/10 space-y-4\">\n          <div className=\"flex items-center gap-2 text-[#DCB8FF] font-heading font-bold text-base border-b border-white/10 pb-3\">\n            <ImageIcon className=\"w-5 h-5\" />\n            <span>Affiche Haute D\303\251finition</span>\n          </div>\n\n          <div>\n            <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400 block mb-2\">\n              S\303\251lectionner un visuel pr\303\251configur\303\251\n            </label>\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-2.5\">\n              {PRESET_POSTERS.map((preset, idx) => (\n                <div\n                  key={idx}\n                  onClick={() => setPosterUrl(preset.url)}\n                  className={`relative h-24 rounded-xl overflow-hidden cursor-pointer border-2 transition-all ${\n                    posterUrl === preset.url\n                      ? \'border-[#E9C349] ring-2 ring-[#E9C349]/40 scale-[1.02]\'\n                      : \'border-transparent opacity-60 hover:opacity-100\'\n                  }`}\n                >\n                  <img\n                    src={preset.url}\n                    alt={preset.name}\n                    className=\"w-full h-full object-cover\"\n                  />\n                  <div className=\"absolute inset-0 bg-black/40 flex items-end p-2\">\n                    <span className=\"text-[10px] font-bold text-white truncate\">\n                      {preset.name}\n                    </span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* YouTube Promo Link */}\n          <div className=\"flex flex-col gap-1.5\">\n            <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n              Lien Spot Vid\303\251o / YouTube (Optionnel)\n            </label>\n            <div className=\"input-glass rounded-xl px-4 py-3 flex items-center gap-2\">\n              <Link className=\"w-4 h-4 text-gray-400\" />\n              <input\n                type=\"url\"\n                value={youtubeUrl}\n                onChange={(e) => setYoutubeUrl(e.target.value)}\n                placeholder=\"https://youtube.com/watch?v=...\"\n                className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0\"\n              />\n            </div>\n          </div>\n        </section>\n\n        {/* Pricing & Contact Section */}\n        <section className=\"bg-[#1F1F1F] rounded-2xl p-6 border border-white/10 space-y-4\">\n          <div className=\"flex items-center gap-2 text-[#E9C349] font-heading font-bold text-base border-b border-white/10 pb-3\">\n            <DollarSign className=\"w-5 h-5\" />\n            <span>Tarification (FCFA) & Contact WhatsApp S\303\251n\303\251gal</span>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n                Prix Billet Standard (FCFA)\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3 flex items-center justify-between\">\n                <input\n                  type=\"number\"\n                  min=\"500\"\n                  step=\"500\"\n                  required\n                  value={price}\n                  onChange={(e) => setPrice(Number(e.target.value))}\n                  className=\"w-full bg-transparent border-none outline-none text-white font-bold text-base focus:ring-0 p-0\"\n                />\n                <span className=\"text-xs font-bold text-[#E9C349] ml-2\">FCFA</span>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n                Num\303\251ro WhatsApp Organisateur\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3 flex items-center gap-2\">\n                <Phone className=\"w-4 h-4 text-emerald-400\" />\n                <input\n                  type=\"tel\"\n                  value={whatsappContact}\n                  onChange={(e) => setWhatsappContact(e.target.value)}\n                  placeholder=\"+221 77 XXX XX XX\"\n                  className=\"w-full bg-transparent border-none outline-none text-white text-sm focus:ring-0 p-0\"\n                />\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Submit Action Button */}\n        <div className=\"pt-4\">\n          <button\n            type=\"submit\"\n            disabled={isSubmitting}\n            className=\"w-full btn-gold-glow py-4 px-6 rounded-2xl font-heading font-extrabold text-sm tracking-wider uppercase flex items-center justify-center gap-2 transition-all disabled:opacity-50\"\n          >\n            {isSubmitting ? (\n              <div className=\"flex items-center gap-2\">\n                <span className=\"w-5 h-5 border-2 border-[#241A00] border-t-transparent rounded-full animate-spin\" />\n                <span>Envoi vers Supabase & Mod\303\251ration...</span>\n              </div>\n            ) : (\n              <>\n                <CheckCircle2 className=\"w-5 h-5\" />\n                <span>Publier pour Mod\303\251ration Administrative</span>\n              </>\n            )}\n          </button>\n        </div>\n      </form>\n    </div>\n  );\n};\n"
    }
