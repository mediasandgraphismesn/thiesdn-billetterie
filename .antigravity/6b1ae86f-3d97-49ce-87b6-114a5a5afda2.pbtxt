  file_change {
    absolute_path_uri: "file:///src/views/AuthView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Mail, Lock, Eye, EyeOff, ArrowRight, Sparkles, Crown, Shield } from \'lucide-react\';\n\ninterface AuthViewProps {\n  onLoginSuccess: (role?: \'user\' | \'promoter\' | \'admin\') => void;\n}\n\nexport const AuthView: React.FC<AuthViewProps> = ({ onLoginSuccess }) => {\n  const [isRegister, setIsRegister] = useState(false);\n  const [email, setEmail] = useState(\'alex.nightlife@example.com\');\n  const [password, setPassword] = useState(\'secret123\');\n  const [showPassword, setShowPassword] = useState(false);\n  const [loading, setLoading] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setTimeout(() => {\n      setLoading(false);\n      onLoginSuccess(\'user\');\n    }, 600);\n  };\n\n  return (\n    <div className=\"min-h-screen flex items-center justify-center p-4 relative overflow-hidden bg-[#0A0A0A]\">\n      {/* African / Diamond Dark Pattern Backdrop matching Image 4 */}\n      <div \n        className=\"absolute inset-0 pointer-events-none opacity-20\"\n        style={{\n          backgroundImage: `radial-gradient(#8A2BE2 1px, transparent 1px), radial-gradient(#E9C349 1px, #0A0A0A 1px)`,\n          backgroundSize: \'32px 32px\',\n          backgroundPosition: \'0 0, 16px 16px\',\n        }}\n      />\n      <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#8A2BE2]/15 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"w-full max-w-md relative z-10 flex flex-col items-center\">\n        {/* White Logo Card with Golden/Violet Signature Brand matching Image 4 */}\n        <div className=\"w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-white flex items-center justify-center p-4 shadow-2xl shadow-[#8A2BE2]/30 mb-5 transform hover:scale-105 transition-transform\">\n          <div className=\"text-center\">\n            <span className=\"font-heading text-3xl sm:text-4xl font-extrabold tracking-tighter bg-gradient-to-r from-[#8A2BE2] via-[#B8860B] to-[#D4AF37] bg-clip-text text-transparent block\">\n              thiesdn\n            </span>\n          </div>\n        </div>\n\n        {/* Brand Headline matching Image 4 */}\n        <div className=\"text-center mb-6\">\n          <h1 className=\"font-heading text-2xl sm:text-3xl font-extrabold text-[#E9C349] tracking-wider uppercase\">\n            THIESDN\n          </h1>\n          <p className=\"text-xs text-gray-300 font-semibold tracking-widest uppercase mt-0.5\">\n            Acc\303\250s Exclusif\n          </p>\n        </div>\n\n        {/* Login Container Box matching Image 4 */}\n        <div className=\"w-full bg-[#181818]/90 backdrop-blur-2xl border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5\">\n          <form onSubmit={handleSubmit} className=\"space-y-4\">\n            {/* Email Field */}\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-[11px] font-bold uppercase tracking-wider text-gray-400\">\n                EMAIL\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3.5 flex items-center gap-3\">\n                <Mail className=\"w-4 h-4 text-gray-400\" />\n                <input\n                  type=\"email\"\n                  required\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  placeholder=\"votre@email.com\"\n                  className=\"bg-transparent border-none outline-none text-white text-sm w-full p-0 focus:ring-0 placeholder-gray-600\"\n                />\n              </div>\n            </div>\n\n            {/* Password Field */}\n            <div className=\"flex flex-col gap-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-[11px] font-bold uppercase tracking-wider text-gray-400\">\n                  MOT DE PASSE\n                </label>\n                <button\n                  type=\"button\"\n                  onClick={() => alert(\'Un lien de r\303\251initialisation vous a \303\251t\303\251 envoy\303\251 par email.\')}\n                  className=\"text-[11px] font-semibold text-[#DCB8FF] hover:underline\"\n                >\n                  Oubli\303\251?\n                </button>\n              </div>\n              <div className=\"input-glass rounded-xl px-4 py-3.5 flex items-center gap-3\">\n                <Lock className=\"w-4 h-4 text-gray-400\" />\n                <input\n                  type={showPassword ? \'text\' : \'password\'}\n                  required\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                  className=\"bg-transparent border-none outline-none text-white text-sm w-full p-0 focus:ring-0 placeholder-gray-600\"\n                />\n                <button\n                  type=\"button\"\n                  onClick={() => setShowPassword(!showPassword)}\n                  className=\"text-gray-400 hover:text-white\"\n                >\n                  {showPassword ? <EyeOff className=\"w-4 h-4\" /> : <Eye className=\"w-4 h-4\" />}\n                </button>\n              </div>\n            </div>\n\n            {/* Primary Submit Button matching Image 4 */}\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"w-full btn-primary-glow py-3.5 rounded-2xl font-heading font-bold text-sm tracking-wider flex items-center justify-center gap-2 transition-all mt-2\"\n            >\n              {loading ? (\n                <span className=\"w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n              ) : (\n                <>\n                  <span>{isRegister ? \"S\'inscrire\" : \'Se connecter\'}</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </>\n              )}\n            </button>\n          </form>\n\n          {/* Divider \"ou\" matching Image 4 */}\n          <div className=\"flex items-center my-4\">\n            <div className=\"flex-1 border-t border-white/10\" />\n            <span className=\"px-3 text-xs text-gray-500 uppercase\">ou</span>\n            <div className=\"flex-1 border-t border-white/10\" />\n          </div>\n\n          {/* Google Sign In matching Image 4 */}\n          <button\n            onClick={() => onLoginSuccess(\'user\')}\n            className=\"w-full py-3 px-4 rounded-2xl bg-[#242424] hover:bg-[#2e2e2e] text-white border border-white/10 text-xs font-semibold flex items-center justify-center gap-2.5 transition-all\"\n          >\n            <div className=\"w-4 h-4 rounded-full bg-white text-black flex items-center justify-center font-bold text-[10px]\">\n              G\n            </div>\n            <span>Continuer avec Google</span>\n          </button>\n\n          {/* Quick Demo Role Buttons for seamless testing */}\n          <div className=\"pt-3 border-t border-white/5 space-y-2\">\n            <p className=\"text-[10px] uppercase tracking-wider text-gray-500 font-bold text-center\">\n              Acc\303\250s D\303\251mo Rapide (1-Click)\n            </p>\n            <div className=\"grid grid-cols-3 gap-2\">\n              <button\n                onClick={() => onLoginSuccess(\'user\')}\n                className=\"p-2 rounded-xl bg-white/5 hover:bg-[#8A2BE2]/20 border border-white/5 text-[11px] text-[#DCB8FF] font-bold transition-all text-center\"\n              >\n                VIP Member\n              </button>\n              <button\n                onClick={() => onLoginSuccess(\'promoter\')}\n                className=\"p-2 rounded-xl bg-white/5 hover:bg-[#E9C349]/20 border border-white/5 text-[11px] text-[#E9C349] font-bold transition-all text-center\"\n              >\n                Promoteur\n              </button>\n              <button\n                onClick={() => onLoginSuccess(\'admin\')}\n                className=\"p-2 rounded-xl bg-white/5 hover:bg-[#8A2BE2]/30 border border-white/5 text-[11px] text-white font-bold transition-all text-center\"\n              >\n                Mod\303\251rateur\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Toggle Text matching Image 4 */}\n        <div className=\"mt-6 text-center text-xs text-gray-400\">\n          <span>{isRegister ? \'D\303\251j\303\240 un compte ?\' : \'Nouveau sur Thiesdn ?\'} </span>\n          <button\n            onClick={() => setIsRegister(!isRegister)}\n            className=\"font-bold text-[#E9C349] hover:underline ml-1\"\n          >\n            {isRegister ? \'Se connecter\' : \"S\'inscrire\"}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
