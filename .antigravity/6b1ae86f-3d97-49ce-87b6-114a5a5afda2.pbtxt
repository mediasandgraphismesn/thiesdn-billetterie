  file_change {
    absolute_path_uri: "file:///src/services/supabase.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { createClient, SupabaseClient } from \'@supabase/supabase-js\';\nimport { EventItem, UserTicket, UserProfile, TicketTier } from \'../types\';\nimport { INITIAL_EVENTS, INITIAL_TICKETS, INITIAL_USER } from \'../data/mockEvents\';\n\n// Environment variables or localStorage config\nconst getEnvVar = (key: string): string => {\n  if (typeof window !== \'undefined\') {\n    const local = localStorage.getItem(key);\n    if (local) return local;\n  }\n  return (import.meta as any).env?.[key] || \'\';\n};\n\nlet supabaseUrl = getEnvVar(\'VITE_SUPABASE_URL\') || \'https://xyzcompany.supabase.co\';\nlet supabaseAnonKey = getEnvVar(\'VITE_SUPABASE_ANON_KEY\') || \'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\';\n\nexport interface SupabaseConfig {\n  url: string;\n  anonKey: string;\n  isConnected: boolean;\n}\n\nexport interface TransactionRecord {\n  id: string;\n  ticketId: string;\n  eventId: string;\n  eventTitle: string;\n  promoterId: string;\n  promoterName: string;\n  customerName: string;\n  customerPhone: string;\n  paymentMethod: \'wave\' | \'om\' | \'yas\' | \'card\';\n  totalAmount: number; // in FCFA\n  promoterShare: number; // 90%\n  platformFee: number; // 10%\n  operatorFee: number; // 1%\n  status: \'completed\' | \'pending\' | \'refunded\';\n  createdAt: string;\n}\n\n// In-memory or localStorage store for persistence when offline or live demo\nconst STORAGE_EVENTS_KEY = \'thiesdn_events_v2\';\nconst STORAGE_TICKETS_KEY = \'thiesdn_tickets_v2\';\nconst STORAGE_TRANSACTIONS_KEY = \'thiesdn_transactions_v2\';\n\nlet cachedClient: SupabaseClient | null = null;\n\nexport const getSupabaseClient = (): SupabaseClient | null => {\n  const currentUrl = getEnvVar(\'VITE_SUPABASE_URL\');\n  const currentKey = getEnvVar(\'VITE_SUPABASE_ANON_KEY\');\n\n  if (!currentUrl || !currentKey || currentUrl.includes(\'xyzcompany\')) {\n    return null;\n  }\n\n  if (!cachedClient) {\n    try {\n      cachedClient = createClient(currentUrl, currentKey);\n    } catch (e) {\n      console.warn(\'Erreur initialisation Supabase Client:\', e);\n      return null;\n    }\n  }\n  return cachedClient;\n};\n\nexport const saveSupabaseCredentials = (url: string, anonKey: string) => {\n  if (typeof window !== \'undefined\') {\n    localStorage.setItem(\'VITE_SUPABASE_URL\', url.trim());\n    localStorage.setItem(\'VITE_SUPABASE_ANON_KEY\', anonKey.trim());\n    cachedClient = null; // reset client\n  }\n};\n\nexport const isSupabaseConfigured = (): boolean => {\n  const url = getEnvVar(\'VITE_SUPABASE_URL\');\n  const key = getEnvVar(\'VITE_SUPABASE_ANON_KEY\');\n  return Boolean(url && key && !url.includes(\'xyzcompany\'));\n};\n\n// Initial transactions seed\nconst INITIAL_TRANSACTIONS: TransactionRecord[] = [\n  {\n    id: \'tx-9921\',\n    ticketId: \'tkt-thiesdn-9921\',\n    eventId: \'evt-thies-gala\',\n    eventTitle: \'Nuit du Baobab Prestige \342\200\224 Thi\303\250s\',\n    promoterId: \'prom-thies-1\',\n    promoterName: \'Lat Dior Productions\',\n    customerName: \'Alexandre Dupont\',\n    customerPhone: \'+221 77 555 12 34\',\n    paymentMethod: \'wave\',\n    totalAmount: 150000,\n    promoterShare: 135000, // 90%\n    platformFee: 15000, // 10%\n    operatorFee: 1500, // 1%\n    status: \'completed\',\n    createdAt: new Date(Date.now() - 3600000 * 24).toISOString(),\n  },\n  {\n    id: \'tx-4812\',\n    ticketId: \'tkt-thiesdn-4812\',\n    eventId: \'evt-saly-beach\',\n    eventTitle: \'Saly Sunset Oasis & Beach Festival\',\n    promoterId: \'prom-saly-lounge\',\n    promoterName: \'Teranga Beach & Lounge\',\n    customerName: \'Alexandre Dupont\',\n    customerPhone: \'+221 78 444 88 99\',\n    paymentMethod: \'om\',\n    totalAmount: 50000,\n    promoterShare: 45000, // 90%\n    platformFee: 5000, // 10%\n    operatorFee: 500, // 1%\n    status: \'completed\',\n    createdAt: new Date(Date.now() - 3600000 * 12).toISOString(),\n  },\n];\n\n// Helper to load transactions\nexport const getStoredTransactions = (): TransactionRecord[] => {\n  if (typeof window === \'undefined\') return INITIAL_TRANSACTIONS;\n  const stored = localStorage.getItem(STORAGE_TRANSACTIONS_KEY);\n  if (stored) {\n    try {\n      return JSON.parse(stored);\n    } catch {\n      return INITIAL_TRANSACTIONS;\n    }\n  }\n  localStorage.setItem(STORAGE_TRANSACTIONS_KEY, JSON.stringify(INITIAL_TRANSACTIONS));\n  return INITIAL_TRANSACTIONS;\n};\n\nexport const saveTransaction = (tx: TransactionRecord): TransactionRecord[] => {\n  const current = getStoredTransactions();\n  const updated = [tx, ...current];\n  if (typeof window !== \'undefined\') {\n    localStorage.setItem(STORAGE_TRANSACTIONS_KEY, JSON.stringify(updated));\n  }\n  return updated;\n};\n\n// Calculate financial split helper\nexport const calculateCommissionSplit = (amount: number) => {\n  const promoterShare = Math.round(amount * 0.90);\n  const platformFee = Math.round(amount * 0.10);\n  const operatorFee = Math.round(amount * 0.01);\n  return {\n    total: amount,\n    promoterShare,\n    platformFee,\n    operatorFee,\n  };\n};\n\n// Supabase SQL Blueprint helper string for user convenience\nexport const SUPABASE_SQL_SCHEMA = `-- ========================================================\n-- THIESDN BILLETTERIE - SCHEMA COMPLET SUPABASE\n-- R\303\251gion : S\303\251n\303\251gal (Thi\303\250s, Mbour, Saly, Dakar)\n-- Mobile Money : Wave, Orange Money, YAS\n-- ========================================================\n\n-- 1. Table des profils utilisateurs & r\303\264les\nCREATE TABLE IF NOT EXISTS public.profiles (\n  id UUID REFERENCES auth.users ON DELETE CASCADE PRIMARY KEY,\n  name TEXT NOT NULL,\n  username TEXT UNIQUE,\n  email TEXT,\n  phone TEXT,\n  address TEXT,\n  avatar TEXT,\n  is_vip BOOLEAN DEFAULT false,\n  role TEXT CHECK (role IN (\'user\', \'promoter\', \'admin\')) DEFAULT \'user\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\n-- 2. Table des \303\251v\303\251nements\nCREATE TABLE IF NOT EXISTS public.events (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  title TEXT NOT NULL,\n  category TEXT NOT NULL,\n  date TEXT NOT NULL,\n  time TEXT NOT NULL,\n  datetime_iso TIMESTAMP WITH TIME ZONE NOT NULL,\n  venue TEXT NOT NULL,\n  city TEXT NOT NULL CHECK (city IN (\'Thi\303\250s\', \'Mbour\', \'Saly\', \'Dakar\', \'Autre\')),\n  poster_url TEXT NOT NULL,\n  price NUMERIC NOT NULL,\n  promoter_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL,\n  promoter_name TEXT NOT NULL,\n  promoter_avatar TEXT,\n  promoter_verified BOOLEAN DEFAULT false,\n  status TEXT CHECK (status IN (\'approved\', \'pending\', \'rejected\')) DEFAULT \'pending\',\n  featured BOOLEAN DEFAULT false,\n  vip_available BOOLEAN DEFAULT true,\n  is_exclusive BOOLEAN DEFAULT false,\n  description TEXT,\n  youtube_url TEXT,\n  whatsapp_contact TEXT,\n  tiers JSONB DEFAULT \'[]\'::jsonb,\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\n-- 3. Table des billets achet\303\251s (Pass QR)\nCREATE TABLE IF NOT EXISTS public.tickets (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  event_id UUID REFERENCES public.events(id) ON DELETE CASCADE,\n  user_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL,\n  event_title TEXT NOT NULL,\n  event_poster TEXT,\n  event_date TEXT NOT NULL,\n  event_time TEXT NOT NULL,\n  event_venue TEXT NOT NULL,\n  tier_name TEXT NOT NULL,\n  price NUMERIC NOT NULL,\n  qr_code TEXT UNIQUE NOT NULL,\n  seat_number TEXT,\n  holder_name TEXT NOT NULL,\n  status TEXT CHECK (status IN (\'valid\', \'used\', \'cancelled\')) DEFAULT \'valid\',\n  purchased_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\n-- 4. Table des transactions & commissions (90% Promoteur / 10% Thiesdn / 1% Op\303\251rateur)\nCREATE TABLE IF NOT EXISTS public.transactions (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  ticket_id UUID REFERENCES public.tickets(id) ON DELETE SET NULL,\n  event_id UUID REFERENCES public.events(id) ON DELETE SET NULL,\n  promoter_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL,\n  customer_name TEXT NOT NULL,\n  customer_phone TEXT,\n  payment_method TEXT CHECK (payment_method IN (\'wave\', \'om\', \'yas\', \'card\')),\n  total_amount NUMERIC NOT NULL,\n  promoter_share NUMERIC NOT NULL, -- 90%\n  platform_fee NUMERIC NOT NULL,   -- 10%\n  operator_fee NUMERIC NOT NULL,   -- 1% Wave/OM/Yas\n  status TEXT DEFAULT \'completed\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\n-- 5. Fonction RPC : Validation s\303\251curis\303\251e du billet au scanner\nCREATE OR REPLACE FUNCTION public.scan_ticket(ticket_code TEXT)\nRETURNS JSONB\nLANGUAGE plpgsql\nSECURITY DEFINER\nAS $$\nDECLARE\n  found_ticket public.tickets%ROWTYPE;\nBEGIN\n  SELECT * INTO found_ticket FROM public.tickets\n  WHERE qr_code = ticket_code OR id::text = ticket_code\n  LIMIT 1;\n\n  IF NOT FOUND THEN\n    RETURN jsonb_build_object(\'success\', false, \'message\', \'Billet introuvable ou faux\');\n  END IF;\n\n  IF found_ticket.status = \'used\' THEN\n    RETURN jsonb_build_object(\'success\', false, \'message\', \'Billet d\303\251j\303\240 valid\303\251 \303\240 l\'\'entr\303\251e !\', \'ticket\', row_to_json(found_ticket));\n  END IF;\n\n  UPDATE public.tickets\n  SET status = \'used\'\n  WHERE id = found_ticket.id;\n\n  RETURN jsonb_build_object(\n    \'success\', true, \n    \'message\', \'Acc\303\250s Autoris\303\251 : \' || found_ticket.tier_name,\n    \'ticket\', jsonb_build_object(\n      \'id\', found_ticket.id,\n      \'holder_name\', found_ticket.holder_name,\n      \'event_title\', found_ticket.event_title,\n      \'tier_name\', found_ticket.tier_name,\n      \'status\', \'used\'\n    )\n  );\nEND;\n$$;\n\n-- 6. Trigger : Cr\303\251ation automatique de transaction avec calcul de commission\nCREATE OR REPLACE FUNCTION public.create_transaction_after_ticket()\nRETURNS TRIGGER\nLANGUAGE plpgsql\nSECURITY DEFINER\nAS $$\nDECLARE\n  evt public.events%ROWTYPE;\n  v_promoter_share NUMERIC;\n  v_platform_fee NUMERIC;\n  v_operator_fee NUMERIC;\nBEGIN\n  SELECT * INTO evt FROM public.events WHERE id = NEW.event_id;\n  \n  v_promoter_share := ROUND(NEW.price * 0.90);\n  v_platform_fee := ROUND(NEW.price * 0.10);\n  v_operator_fee := ROUND(NEW.price * 0.01);\n\n  INSERT INTO public.transactions (\n    ticket_id,\n    event_id,\n    promoter_id,\n    customer_name,\n    total_amount,\n    promoter_share,\n    platform_fee,\n    operator_fee,\n    status\n  ) VALUES (\n    NEW.id,\n    NEW.event_id,\n    evt.promoter_id,\n    NEW.holder_name,\n    NEW.price,\n    v_promoter_share,\n    v_platform_fee,\n    v_operator_fee,\n    \'completed\'\n  );\n\n  RETURN NEW;\nEND;\n$$;\n\nDROP TRIGGER IF EXISTS trigger_ticket_transaction ON public.tickets;\nCREATE TRIGGER trigger_ticket_transaction\nAFTER INSERT ON public.tickets\nFOR EACH ROW\nEXECUTE FUNCTION public.create_transaction_after_ticket();\n\n-- 7. Activer RLS\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.events ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.tickets ENABLE ROW LEVEL SECURITY;\nALTER TABLE public.transactions ENABLE ROW LEVEL SECURITY;\n\n-- Politiques de lecture publique des \303\251v\303\251nements valid\303\251s\nCREATE POLICY \"Public can view approved events\" ON public.events\nFOR SELECT USING (status = \'approved\' OR auth.role() = \'authenticated\');\n`;\n"
    }
