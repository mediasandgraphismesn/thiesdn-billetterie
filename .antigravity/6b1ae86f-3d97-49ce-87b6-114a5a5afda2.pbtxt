        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "-- 4. Table des transactions & commissions (90% Promoteur / 10% Thiesdn / 1% Op\303\251rateur)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS public.transactions ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  ticket_id UUID REFERENCES public.tickets(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  event_id UUID REFERENCES public.events(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  promoter_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  customer_name TEXT NOT NULL,"
