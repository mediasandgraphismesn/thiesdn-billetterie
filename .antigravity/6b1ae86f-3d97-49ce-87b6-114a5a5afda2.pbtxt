  file_change {
    absolute_path_uri: "file:///src/components/BottomNav.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Home, Compass, Ticket, ShieldCheck, User, Wallet } from \'lucide-react\';\n\ninterface BottomNavProps {\n  activeTab: string;\n  onTabChange: (tab: string) => void;\n  pendingCount?: number;\n  ticketsCount?: number;\n  userRole: \'user\' | \'promoter\' | \'admin\';\n}\n\nexport const BottomNav: React.FC<BottomNavProps> = ({\n  activeTab,\n  onTabChange,\n  pendingCount = 0,\n  ticketsCount = 0,\n  userRole,\n}) => {\n  const tabs = [\n    { id: \'home\', label: \'Home\', icon: Home },\n    { id: \'explore\', label: \'Explore\', icon: Compass },\n    {\n      id: \'tickets\',\n      label: \'Tickets\',\n      icon: Ticket,\n      badge: ticketsCount > 0 ? ticketsCount : undefined,\n    },\n    ...(userRole === \'admin\' || userRole === \'promoter\'\n      ? [\n          {\n            id: \'moderation\',\n            label: \'Mod\303\251ration\',\n            icon: ShieldCheck,\n            badge: pendingCount > 0 ? pendingCount : undefined,\n            badgeColor: \'bg-[#E9C349] text-[#241A00]\',\n          },\n          {\n            id: \'finances\',\n            label: \'Finances\',\n            icon: Wallet,\n          },\n        ]\n      : []),\n    { id: \'profile\', label: \'Profil\', icon: User },\n  ];\n\n  return (\n    <nav className=\"lg:hidden fixed bottom-3 left-3 right-3 h-16 max-w-lg mx-auto z-50 flex items-center justify-around px-2 bg-[#1C1B1B]/90 backdrop-blur-2xl rounded-full border border-white/10 shadow-2xl shadow-[#8A2BE2]/20\">\n      {tabs.map((tab) => {\n        const Icon = tab.icon;\n        const isActive = activeTab === tab.id;\n\n        return (\n          <button\n            key={tab.id}\n            onClick={() => onTabChange(tab.id)}\n            className={`relative flex flex-col items-center justify-center transition-all py-1.5 px-3 rounded-full ${\n              isActive\n                ? \'bg-[#8A2BE2] text-white shadow-lg shadow-[#8A2BE2]/40 scale-105\'\n                : \'text-[#CFC2D7] hover:text-white opacity-80\'\n            }`}\n          >\n            <div className=\"relative\">\n              <Icon className={`w-4 h-4 ${isActive ? \'stroke-[2.5]\' : \'stroke-[1.8]\'}`} />\n              {tab.badge !== undefined && (\n                <span\n                  className={`absolute -top-1.5 -right-2 text-[9px] font-extrabold px-1 py-0.1 rounded-full min-w-[14px] text-center ${\n                    tab.badgeColor || \'bg-[#8A2BE2] text-white\'\n                  }`}\n                >\n                  {tab.badge}\n                </span>\n              )}\n            </div>\n            <span\n              className={`text-[9px] font-semibold mt-0.5 tracking-tight ${\n                isActive ? \'text-white\' : \'text-[#CFC2D7]\'\n              }`}\n            >\n              {tab.label}\n            </span>\n          </button>\n        );\n      })}\n    </nav>\n  );\n};\n"
    }
