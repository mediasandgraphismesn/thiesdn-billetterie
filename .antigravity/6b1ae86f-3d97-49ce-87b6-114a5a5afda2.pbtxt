          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Helper to load transactions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const getStoredTransactions = (): TransactionRecord[] => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (typeof window === \'undefined\') return INITIAL_TRANSACTIONS;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const stored = localStorage.getItem(STORAGE_TRANSACTIONS_KEY);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (stored) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    try {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return JSON.parse(stored);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    } catch {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return INITIAL_TRANSACTIONS;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  localStorage.setItem(STORAGE_TRANSACTIONS_KEY, JSON.stringify(INITIAL_TRANSACTIONS));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return INITIAL_TRANSACTIONS;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const saveTransaction = (tx: TransactionRecord): TransactionRecord[] => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const current = getStoredTransactions();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const updated = [tx, ...current];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (typeof window !== \'undefined\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    localStorage.setItem(STORAGE_TRANSACTIONS_KEY, JSON.stringify(updated));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return updated;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Calculate financial split helper"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const calculateCommissionSplit = (amount: number) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const promoterShare = Math.round(amount * 0.90);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const platformFee = Math.round(amount * 0.10);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const operatorFee = Math.round(amount * 0.01);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    total: amount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    promoterShare,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    platformFee,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    operatorFee,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Supabase SQL Blueprint helper string for user convenience"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const SUPABASE_SQL_SCHEMA = `-- ========================================================"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- THIESDN BILLETTERIE - SCHEMA COMPLET SUPABASE"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- R\303\251gion : S\303\251n\303\251gal (Thi\303\250s, Mbour, Saly, Dakar)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- Mobile Money : Wave, Orange Money, YAS"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- ========================================================"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 1. Table des profils utilisateurs & r\303\264les"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS public.profiles ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id UUID REFERENCES auth.users ON DELETE CASCADE PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  username TEXT UNIQUE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  email TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  phone TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  address TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  avatar TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  is_vip BOOLEAN DEFAULT false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  role TEXT CHECK (role IN (\'user\', \'promoter\', \'admin\')) DEFAULT \'user\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 2. Table des \303\251v\303\251nements"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS public.events ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  title TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  category TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  date TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  time TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  datetime_iso TIMESTAMP WITH TIME ZONE NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  venue TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  city TEXT NOT NULL CHECK (city IN (\'Thi\303\250s\', \'Mbour\', \'Saly\', \'Dakar\', \'Autre\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  poster_url TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  price NUMERIC NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  promoter_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  promoter_name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  promoter_avatar TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  promoter_verified BOOLEAN DEFAULT false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  status TEXT CHECK (status IN (\'approved\', \'pending\', \'rejected\')) DEFAULT \'pending\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  featured BOOLEAN DEFAULT false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  vip_available BOOLEAN DEFAULT true,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  is_exclusive BOOLEAN DEFAULT false,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  description TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  youtube_url TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  whatsapp_contact TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  tiers JSONB DEFAULT \'[]\'::jsonb,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 3. Table des billets achet\303\251s (Pass QR)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS public.tickets ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  event_id UUID REFERENCES public.events(id) ON DELETE CASCADE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  user_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  event_title TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  event_poster TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  event_date TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  event_time TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  event_venue TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  tier_name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  price NUMERIC NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  qr_code TEXT UNIQUE NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  seat_number TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  holder_name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  status TEXT CHECK (status IN (\'valid\', \'used\', \'cancelled\')) DEFAULT \'valid\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  purchased_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 4. Table des transactions & commissions (90% Promoteur / 10% Thiesdn / 1% Op\303\251rateur)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE IF NOT EXISTS public.transactions ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ticket_id UUID REFERENCES public.tickets(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  event_id UUID REFERENCES public.events(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  promoter_id UUID REFERENCES public.profiles(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  customer_name TEXT NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  customer_phone TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  payment_method TEXT CHECK (payment_method IN (\'wave\', \'om\', \'yas\', \'card\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  total_amount NUMERIC NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  promoter_share NUMERIC NOT NULL, -- 90%"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  platform_fee NUMERIC NOT NULL,   -- 10%"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  operator_fee NUMERIC NOT NULL,   -- 1% Wave/OM/Yas"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  status TEXT DEFAULT \'completed\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 5. Fonction RPC : Validation s\303\251curis\303\251e du billet au scanner"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE OR REPLACE FUNCTION public.scan_ticket(ticket_code TEXT)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "RETURNS JSONB"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "LANGUAGE plpgsql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "SECURITY DEFINER"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "AS $$"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "DECLARE"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  found_ticket public.tickets%ROWTYPE;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "BEGIN"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  SELECT * INTO found_ticket FROM public.tickets"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  WHERE qr_code = ticket_code OR id::text = ticket_code"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  LIMIT 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  IF NOT FOUND THEN"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RETURN jsonb_build_object(\'success\', false, \'message\', \'Billet introuvable ou faux\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  END IF;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  IF found_ticket.status = \'used\' THEN"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RETURN jsonb_build_object(\'success\', false, \'message\', \'Billet d\303\251j\303\240 valid\303\251 \303\240 l\'\'entr\303\251e !\', \'ticket\', row_to_json(found_ticket));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  END IF;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  UPDATE public.tickets"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  SET status = \'used\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  WHERE id = found_ticket.id;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  RETURN jsonb_build_object("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \'success\', true, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \'message\', \'Acc\303\250s Autoris\303\251 : \' || found_ticket.tier_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    \'ticket\', jsonb_build_object("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'id\', found_ticket.id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'holder_name\', found_ticket.holder_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'event_title\', found_ticket.event_title,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'tier_name\', found_ticket.tier_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'status\', \'used\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "END;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "$$;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 6. Trigger : Cr\303\251ation automatique de transaction avec calcul de commission"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE OR REPLACE FUNCTION public.create_transaction_after_ticket()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "RETURNS TRIGGER"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "LANGUAGE plpgsql"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "SECURITY DEFINER"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "AS $$"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "DECLARE"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  evt public.events%ROWTYPE;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  v_promoter_share NUMERIC;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  v_platform_fee NUMERIC;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  v_operator_fee NUMERIC;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "BEGIN"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  SELECT * INTO evt FROM public.events WHERE id = NEW.event_id;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  v_promoter_share := ROUND(NEW.price * 0.90);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  v_platform_fee := ROUND(NEW.price * 0.10);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  v_operator_fee := ROUND(NEW.price * 0.01);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  INSERT INTO public.transactions ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ticket_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    event_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    promoter_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    customer_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    total_amount,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    promoter_share,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    platform_fee,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    operator_fee,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    status"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ) VALUES ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    NEW.id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    NEW.event_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    evt.promoter_id,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    NEW.holder_name,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
