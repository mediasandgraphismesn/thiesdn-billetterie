  file_change {
    absolute_path_uri: "file:///src/views/ExploreView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  MapPin,\n  Calendar,\n  Filter,\n  SlidersHorizontal,\n  Compass,\n  Sparkles,\n  Crown,\n  Layers,\n} from \'lucide-react\';\nimport { EventItem } from \'../types\';\nimport { CATEGORIES, SENEGAL_CITIES } from \'../data/mockEvents\';\nimport { EventCard } from \'../components/EventCard\';\n\ninterface ExploreViewProps {\n  events: EventItem[];\n  onSelectEvent: (event: EventItem) => void;\n}\n\nexport const ExploreView: React.FC<ExploreViewProps> = ({\n  events,\n  onSelectEvent,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCity, setSelectedCity] = useState(\'All\');\n  const [selectedCategory, setSelectedCategory] = useState(\'All\');\n  const [selectedSort, setSelectedSort] = useState<\'date\' | \'price-asc\' | \'price-desc\'>(\'date\');\n  const [viewMode, setViewMode] = useState<\'grid\' | \'map\'>(\'grid\');\n\n  const approvedEvents = events.filter((e) => e.status === \'approved\');\n\n  const filteredEvents = approvedEvents\n    .filter((e) => {\n      const matchesSearch =\n        e.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        e.venue.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        e.city.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        e.promoter.name.toLowerCase().includes(searchQuery.toLowerCase());\n\n      const matchesCity = selectedCity === \'All\' || e.city === selectedCity;\n      const matchesCat = selectedCategory === \'All\' || e.category === selectedCategory;\n\n      return matchesSearch && matchesCity && matchesCat;\n    })\n    .sort((a, b) => {\n      if (selectedSort === \'price-asc\') return a.price - b.price;\n      if (selectedSort === \'price-desc\') return b.price - a.price;\n      return new Date(a.datetimeIso).getTime() - new Date(b.datetimeIso).getTime();\n    });\n\n  return (\n    <div className=\"space-y-6 pb-16 animate-in fade-in duration-300\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-3\">\n        <div>\n          <h1 className=\"font-heading text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n            Explorer les \303\211v\303\251nements au S\303\251n\303\251gal\n          </h1>\n          <p className=\"text-sm text-gray-400 mt-1\">\n            D\303\251couvrez les meilleures soir\303\251es, galas et festivals \303\240 Thi\303\250s, Mbour, Saly et Dakar\n          </p>\n        </div>\n\n        {/* View mode toggle */}\n        <div className=\"flex items-center gap-1 bg-[#1C1B1B] p-1 rounded-xl border border-white/10 self-start sm:self-auto\">\n          <button\n            onClick={() => setViewMode(\'grid\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${\n              viewMode === \'grid\'\n                ? \'bg-[#8A2BE2] text-white shadow-md\'\n                : \'text-gray-400 hover:text-white\'\n            }`}\n          >\n            Grille ({filteredEvents.length})\n          </button>\n          <button\n            onClick={() => setViewMode(\'map\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 ${\n              viewMode === \'map\'\n                ? \'bg-[#8A2BE2] text-white shadow-md\'\n                : \'text-gray-400 hover:text-white\'\n            }`}\n          >\n            <Compass className=\"w-3.5 h-3.5\" />\n            Carte S\303\251n\303\251gal\n          </button>\n        </div>\n      </div>\n\n      {/* Filter Bar */}\n      <div className=\"glass-panel p-4 rounded-2xl space-y-3\">\n        {/* Search */}\n        <div className=\"relative flex items-center bg-[#131313] border border-white/10 rounded-xl px-4 py-2.5 focus-within:border-[#8A2BE2]\">\n          <Search className=\"w-4 h-4 text-gray-400 mr-3\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Rechercher par nom de soir\303\251e, artiste, club \303\240 Thi\303\250s, Saly, Dakar...\"\n            className=\"w-full bg-transparent border-none outline-none text-sm text-white placeholder-gray-500 focus:ring-0 p-0\"\n          />\n        </div>\n\n        {/* City & Category Filter Chips */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 pt-1\">\n          {/* City Chips for Senegal */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1\">\n            {SENEGAL_CITIES.map((city) => (\n              <button\n                key={city}\n                onClick={() => setSelectedCity(city)}\n                className={`px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all ${\n                  selectedCity === city\n                    ? \'bg-[#E9C349] text-[#241A00] font-bold shadow-md\'\n                    : \'bg-[#181818] text-gray-300 hover:bg-[#252525] border border-white/5\'\n                }`}\n              >\n                {city === \'All\' ? \'Toutes R\303\251gions\' : `\360\237\223\215 ${city}`}\n              </button>\n            ))}\n          </div>\n\n          {/* Sort Selector */}\n          <div className=\"flex items-center gap-2 text-xs\">\n            <span className=\"text-gray-400\">Trier par:</span>\n            <select\n              value={selectedSort}\n              onChange={(e) => setSelectedSort(e.target.value as any)}\n              className=\"bg-[#181818] border border-white/10 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-[#8A2BE2] cursor-pointer\"\n            >\n              <option value=\"date\">Date la plus proche</option>\n              <option value=\"price-asc\">Prix croissant (FCFA)</option>\n              <option value=\"price-desc\">Prix d\303\251croissant (VIP Prestige)</option>\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Interactive Map View */}\n      {viewMode === \'map\' && (\n        <div className=\"glass-panel rounded-3xl p-6 relative overflow-hidden space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <Compass className=\"w-5 h-5 text-[#8A2BE2]\" />\n              <h3 className=\"font-heading font-bold text-base text-white\">\n                Radar Carte S\303\251n\303\251gal \342\200\224 {selectedCity === \'All\' ? \'Thi\303\250s, Mbour, Saly, Dakar\' : selectedCity}\n              </h3>\n            </div>\n            <span className=\"text-xs text-[#E9C349] font-bold\">\n              GPS R\303\251seau S\303\251n\303\251gal Actif\n            </span>\n          </div>\n\n          {/* Simulated Nightlife Radar Map Canvas */}\n          <div className=\"relative h-80 sm:h-96 rounded-2xl overflow-hidden bg-gradient-to-br from-[#101015] via-[#15121c] to-[#0d0d10] border border-white/10 flex items-center justify-center p-4\">\n            {/* Grid radar rings */}\n            <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\">\n              <div className=\"w-40 h-40 rounded-full border border-[#8A2BE2]\" />\n              <div className=\"w-72 h-72 rounded-full border border-[#8A2BE2] absolute\" />\n              <div className=\"w-96 h-96 rounded-full border border-[#E9C349] absolute\" />\n            </div>\n\n            {/* Pins */}\n            <div className=\"relative w-full h-full\">\n              {filteredEvents.map((evt, idx) => {\n                const topPercent = 25 + (idx * 22) % 60;\n                const leftPercent = 20 + (idx * 27) % 65;\n\n                return (\n                  <div\n                    key={evt.id}\n                    onClick={() => onSelectEvent(evt)}\n                    style={{ top: `${topPercent}%`, left: `${leftPercent}%` }}\n                    className=\"absolute -translate-x-1/2 -translate-y-1/2 cursor-pointer group z-20\"\n                  >\n                    <div className=\"relative flex flex-col items-center\">\n                      <div className=\"w-8 h-8 rounded-full bg-[#8A2BE2] border-2 border-white flex items-center justify-center shadow-lg shadow-[#8A2BE2]/50 group-hover:scale-125 transition-transform\">\n                        <MapPin className=\"w-4 h-4 text-white\" />\n                      </div>\n                      <div className=\"mt-1 bg-black/80 backdrop-blur-md px-2 py-0.5 rounded text-[10px] font-bold text-white whitespace-nowrap border border-white/10 group-hover:border-[#E9C349] transition-colors\">\n                        {evt.title} \342\200\242 {evt.city} ({evt.price.toLocaleString(\'fr-FR\')} F)\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Grid of Events */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {filteredEvents.map((event) => (\n          <EventCard\n            key={event.id}\n            event={event}\n            variant=\"grid\"\n            onSelect={onSelectEvent}\n          />\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    }
