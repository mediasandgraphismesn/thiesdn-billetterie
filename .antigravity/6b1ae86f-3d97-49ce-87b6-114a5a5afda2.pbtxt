    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  User,\n  Mail,\n  Phone,\n  MapPin,\n  Camera,\n  Share2,\n  Edit3,\n  CheckCircle2,\n  LogOut,\n  Sparkles,\n  Crown,\n  Ticket,\n  ExternalLink,\n} from \'lucide-react\';\nimport { UserProfile, UserTicket } from \'../types\';\n\ninterface ProfileViewProps {\n  user: UserProfile;\n  tickets: UserTicket[];\n  onUpdateProfile: (updated: Partial<UserProfile>) => void;\n  onOpenTicketPass: (ticket: UserTicket) => void;\n  onSignOut: () => void;\n}\n\nexport const ProfileView: React.FC<ProfileViewProps> = ({\n  user,\n  tickets,\n  onUpdateProfile,\n  onOpenTicketPass,\n  onSignOut,\n}) => {\n  const [name, setName] = useState(user.name);\n  const [email, setEmail] = useState(user.email);\n  const [phone, setPhone] = useState(user.phone);\n  const [address, setAddress] = useState(user.address);\n  const [connectedAccounts, setConnectedAccounts] = useState(user.connectedAccounts);\n  const [privacySettings, setPrivacySettings] = useState(user.privacySettings);\n  const [isEditing, setIsEditing] = useState(false);\n  const [savedToast, setSavedToast] = useState(false);\n\n  const handleSaveProfile = () => {\n    onUpdateProfile({\n      name,\n      email,\n      phone,\n      address,\n      connectedAccounts,\n      privacySettings,\n    });\n    setIsEditing(false);\n    setSavedToast(true);\n    setTimeout(() => setSavedToast(false), 2500);\n  };\n\n  const toggleSocial = (platform: \'facebook\' | \'instagram\' | \'tiktok\') => {\n    const updated = {\n      ...connectedAccounts,\n      [platform]: !connectedAccounts[platform],\n    };\n    setConnectedAccounts(updated);\n    onUpdateProfile({ connectedAccounts: updated });\n  };\n\n  const togglePrivacy = (key: \'publicProfile\' | \'biometricLogin\') => {\n    const updated = {\n      ...privacySettings,\n      [key]: !privacySettings[key],\n    };\n    setPrivacySettings(updated);\n    onUpdateProfile({ privacySettings: updated });\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto space-y-6 pb-20 animate-in fade-in duration-300\">\n      {savedToast && (\n        <div className=\"fixed top-20 right-6 z-50 p-4 rounded-2xl bg-[#1C1B1B] border border-emerald-500 shadow-2xl text-white flex items-center gap-3 animate-in slide-in-from-top-4 duration-300\">\n          <CheckCircle2 className=\"w-5 h-5 text-emerald-400\" />\n          <span className=\"text-sm font-semibold\">Profil mis \303\240 jour avec succ\303\250s !</span>\n        </div>\n      )}\n\n      {/* Profile Header Bento matching Image 16 / 18 */}\n      <section className=\"glass-panel rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-center md:items-start gap-6 relative overflow-hidden shadow-2xl\">\n        <div className=\"absolute top-0 right-0 w-48 h-48 bg-[#8A2BE2]/15 rounded-full blur-3xl pointer-events-none\" />\n\n        {/* Avatar with edit badge */}\n        <div className=\"relative group cursor-pointer\">\n          <div className=\"w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden border-2 border-[#8A2BE2] shadow-[0_0_25px_rgba(138,43,226,0.4)]\">\n            <img\n              src={user.avatar}\n              alt={user.name}\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n          <button\n            onClick={() => {\n              const newUrl = prompt(\'Entrez l\342\200\231URL de votre nouvelle photo de profil :\', user.avatar);\n              if (newUrl) onUpdateProfile({ avatar: newUrl });\n            }}\n            className=\"absolute bottom-0 right-0 bg-[#8A2BE2] hover:bg-[#7822c9] text-white p-2.5 rounded-full shadow-lg transition-transform hover:scale-110\"\n            title=\"Changer la photo\"\n          >\n            <Camera className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* User Info */}\n        <div className=\"flex-1 text-center md:text-left space-y-2 z-10\">\n          <div className=\"flex flex-wrap items-center justify-center md:justify-start gap-2\">\n            <h2 className=\"font-heading text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n              {user.username}\n            </h2>\n            {user.isVip && (\n              <span className=\"bg-[#E9C349] text-[#241A00] font-extrabold text-xs px-2.5 py-0.5 rounded-full flex items-center gap-1 shadow-sm\">\n                <Crown className=\"w-3 h-3\" /> VIP Member\n              </span>\n            )}\n          </div>\n          <p className=\"text-sm text-[#CFC2D7] font-medium\">{user.name}</p>\n\n          {/* Action buttons matching Image 18 */}\n          <div className=\"pt-3 flex flex-wrap justify-center md:justify-start gap-3\">\n            {isEditing ? (\n              <button\n                onClick={handleSaveProfile}\n                className=\"btn-primary-glow px-6 py-2.5 rounded-xl text-xs font-heading font-extrabold tracking-wider uppercase\"\n              >\n                Enregistrer les Modifications\n              </button>\n            ) : (\n              <button\n                onClick={() => setIsEditing(true)}\n                className=\"btn-primary-glow px-6 py-2.5 rounded-xl text-xs font-heading font-extrabold tracking-wider uppercase flex items-center gap-2\"\n              >\n                <Edit3 className=\"w-3.5 h-3.5\" />\n                EDIT PROFILE\n              </button>\n            )}\n\n            <button\n              onClick={() => {\n                if (navigator.share) {\n                  navigator.share({\n                    title: `Profil ${user.username} sur Thiesdn`,\n                    text: `Retrouve-moi sur Thiesdn Billetterie pour les soir\303\251es exclusives !`,\n                  }).catch(() => {});\n                } else {\n                  alert(\'Lien de votre profil copi\303\251 !\');\n                }\n              }}\n              className=\"px-6 py-2.5 rounded-xl border border-white/20 hover:border-white/40 text-white text-xs font-heading font-extrabold tracking-wider uppercase bg-[#1C1B1B] hover:bg-[#2A2A2A] transition-all flex items-center gap-2\"\n            >\n              <Share2 className=\"w-3.5 h-3.5\" />\n              SHARE PROFILE\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* Grid: Personal Info & Connected Accounts / Privacy */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Personal Information matching Image 18 */}\n        <section className=\"glass-panel rounded-3xl p-6 space-y-4\">\n          <h3 className=\"font-heading font-bold text-base text-[#E9C349] border-b border-white/10 pb-3 flex items-center justify-between\">\n            <span>Personal Information</span>\n            {isEditing && (\n              <span className=\"text-[11px] text-[#DCB8FF] font-normal\">Mode \303\251dition actif</span>\n            )}\n          </h3>\n\n          <div className=\"space-y-4\">\n            {/* Full Name */}\n            <div className=\"flex flex-col\">\n              <label className=\"text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-1\">\n                Full Name\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3 flex items-center gap-3\">\n                <User className=\"w-4 h-4 text-[#8A2BE2]\" />\n                <input\n                  type=\"text\"\n                  disabled={!isEditing}\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  className=\"bg-transparent border-none outline-none text-white text-sm w-full p-0 focus:ring-0 disabled:opacity-80\"\n                />\n              </div>\n            </div>\n\n            {/* Email */}\n            <div className=\"flex flex-col\">\n              <label className=\"text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-1\">\n                Email\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3 flex items-center gap-3\">\n                <Mail className=\"w-4 h-4 text-[#8A2BE2]\" />\n                <input\n                  type=\"email\"\n                  disabled={!isEditing}\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"bg-transparent border-none outline-none text-white text-sm w-full p-0 focus:ring-0 disabled:opacity-80\"\n                />\n              </div>\n            </div>\n\n            {/* Phone Number */}\n            <div className=\"flex flex-col\">\n              <label className=\"text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-1\">\n                Phone Number\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3 flex items-center gap-3\">\n                <Phone className=\"w-4 h-4 text-[#8A2BE2]\" />\n                <input\n                  type=\"tel\"\n                  disabled={!isEditing}\n                  value={phone}\n                  onChange={(e) => setPhone(e.target.value)}\n                  className=\"bg-transparent border-none outline-none text-white text-sm w-full p-0 focus:ring-0 disabled:opacity-80\"\n                />\n              </div>\n            </div>\n\n            {/* Address */}\n            <div className=\"flex flex-col\">\n              <label className=\"text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-1\">\n                Address\n              </label>\n              <div className=\"input-glass rounded-xl px-4 py-3 flex items-start gap-3\">\n                <MapPin className=\"w-4 h-4 text-[#8A2BE2] mt-0.5\" />\n                <textarea\n                  rows={2}\n                  disabled={!isEditing}\n                  value={address}\n                  onChange={(e) => setAddress(e.target.value)}\n                  className=\"bg-transparent border-none outline-none text-white text-sm w-full p-0 focus:ring-0 resize-none disabled:opacity-80\"\n                />\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Right Column: Connected Accounts & Privacy */}\n        <div className=\"space-y-6\">\n          {/* Connected Accounts matching Image 18 */}\n          <section className=\"glass-panel rounded-3xl p-6 space-y-4\">\n            <h3 className=\"font-heading font-bold text-base text-[#E9C349] border-b border-white/10 pb-3\">\n              Connected Accounts\n            </h3>\n\n            <div className=\"space-y-2.5\">\n              {/* Facebook */}\n              <div\n                onClick={() => toggleSocial(\'facebook\')}\n                className=\"flex items-center justify-between p-3.5 rounded-xl bg-[#1F1F1F] hover:bg-[#28272a] transition-colors cursor-pointer border border-white/5\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-[#1877F2] flex items-center justify-center text-white font-bold text-sm\">\n                    f\n                  </div>\n                  <span className=\"text-sm font-semibold text-white\">Facebook</span>\n                </div>\n                <span\n                  className={`text-xs font-bold ${\n                    connectedAccounts.facebook ? \'text-[#DCB8FF]\' : \'text-gray-500\'\n                  }`}\n                >\n                  {connectedAccounts.facebook ? \'Connected\' : \'Connect\'}\n                </span>\n              </div>\n\n              {/* Instagram */}\n              <div\n                onClick={() => toggleSocial(\'instagram\')}\n                className=\"flex items-center justify-between p-3.5 rounded-xl bg-[#1F1F1F] hover:bg-[#28272a] transition-colors cursor-pointer border border-white/5\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-gradient-to-tr from-[#FFDC80] via-[#F56040] to-[#C13584] flex items-center justify-center text-white font-bold text-xs\">\n                    ig\n                  </div>\n                  <span className=\"text-sm font-semibold text-white\">Instagram</span>\n                </div>\n                <span\n                  className={`text-xs font-bold ${\n                    connectedAccounts.instagram ? \'text-[#DCB8FF]\' : \'text-gray-500\'\n                  }`}\n                >\n                  {connectedAccounts.instagram ? \'Connected\' : \'Connect\'}\n                </span>\n              </div>\n\n              {/* TikTok */}\n              <div\n                onClick={() => toggleSocial(\'tiktok\')}\n                className=\"flex items-center justify-between p-3.5 rounded-xl bg-[#1F1F1F] hover:bg-[#28272a] transition-colors cursor-pointer border border-white/5\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-black border border-white/20 flex items-center justify-center text-white font-bold text-xs\">\n                    tk\n                  </div>\n                  <span className=\"text-sm font-semibold text-white\">TikTok</span>\n                </div>\n                <span\n                  className={`text-xs font-bold ${\n                    connectedAccounts.tiktok ? \'text-[#DCB8FF]\' : \'text-gray-500\'\n                  }`}\n                >\n                  {connectedAccounts.tiktok ? \'Connected\' : \'Connect\'}\n                </span>\n              </div>\n            </div>\n          </section>\n\n          {/* Privacy & Security matching Image 18 */}\n          <section className=\"glass-panel rounded-3xl p-6 space-y-4\">\n            <h3 className=\"font-heading font-bold text-base text-[#E9C349] border-b border-white/10 pb-3\">\n              Privacy & Security\n            </h3>\n\n            <div className=\"space-y-4\">\n              {/* Public Profile */}\n              <div className=\"flex items-center justify-between gap-3\">\n                <div>\n                  <h4 className=\"text-sm font-bold text-white\">Public Profile</h4>\n                  <p className=\"text-xs text-gray-400\">\n                    Allow others to see your attended events.\n                  </p>\n                </div>\n                <label className=\"relative inline-flex items-center cursor-pointer flex-shrink-0\">\n                  <input\n                    type=\"checkbox\"\n                    checked={privacySettings.publicProfile}\n                    onChange={() => togglePrivacy(\'publicProfile\')}\n                    className=\"sr-only peer\"\n                  />\n                  <div className=\"w-11 h-6 bg-[#2A2A2A] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#8A2BE2]\" />\n                </label>\n              </div>\n\n              {/* Biometric Login */}\n              <div className=\"flex items-center justify-between gap-3\">\n                <div>\n                  <h4 className=\"text-sm font-bold text-white\">Biometric Login</h4>\n                  <p className=\"text-xs text-gray-400\">\n                    Use FaceID / Fingerprint to secure app.\n                  </p>\n                </div>\n                <label className=\"relative inline-flex items-center cursor-pointer flex-shrink-0\">\n                  <input\n                    type=\"checkbox\"\n                    checked={privacySettings.biometricLogin}\n                    onChange={() => togglePrivacy(\'biometricLogin\')}\n                    className=\"sr-only peer\"\n                  />\n                  <div className=\"w-11 h-6 bg-[#2A2A2A] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#8A2BE2]\" />\n                </label>\n              </div>\n            </div>\n          </section>\n        </div>\n      </div>\n\n      {/* Mes Pass & Billets Section */}\n      <section className=\"glass-panel rounded-3xl p-6 space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-white/10 pb-3\">\n          <div className=\"flex items-center gap-2\">\n            <Ticket className=\"w-5 h-5 text-[#8A2BE2]\" />\n            <h3 className=\"font-heading font-bold text-base text-white\">\n              Mes Billets & Pass VIP ({tickets.length})\n            </h3>\n          </div>\n          <span className=\"text-xs text-[#DCB8FF]\">Acc\303\250s instantan\303\251 QR</span>\n        </div>\n\n        {tickets.length === 0 ? (\n          <p className=\"text-xs text-gray-400 py-4 text-center\">\n            Vous n\'avez pas encore achet\303\251 de billet. Explorez nos soir\303\251es exclusives !\n          </p>\n        ) : (\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {tickets.map((tkt) => (\n              <div\n                key={tkt.id}\n                onClick={() => onOpenTicketPass(tkt)}\n                className=\"p-4 rounded-2xl bg-[#1A1A1A] border border-white/10 hover:border-[#8A2BE2] cursor-pointer transition-all flex items-center justify-between gap-3 group\"\n              >\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <img\n                    src={tkt.eventPoster}\n                    alt={tkt.eventTitle}\n                    className=\"w-14 h-14 rounded-xl object-cover flex-shrink-0 group-hover:scale-105 transition-transform\"\n                  />\n                  <div className=\"min-w-0\">\n                    <span className=\"text-[10px] font-bold text-[#E9C349] uppercase block truncate\">\n                      {tkt.tierName}\n                    </span>\n                    <h4 className=\"font-heading font-bold text-sm text-white truncate\">\n                      {tkt.eventTitle}\n                    </h4>\n                    <p className=\"text-xs text-gray-400 truncate\">{tkt.eventDate}</p>\n                  </div>\n                </div>\n\n                <button className=\"btn-primary-glow p-2 rounded-xl text-white flex-shrink-0\">\n                  <ExternalLink className=\"w-4 h-4\" />\n                </button>\n              </div>\n            ))}\n          </div>\n        )}\n      </section>\n\n      {/* Sign Out Action matching Image 18 */}\n      <div className=\"flex justify-center pt-4\">\n        <button\n          onClick={onSignOut}\n          className=\"flex items-center gap-2 text-red-400 hover:text-red-300 transition-colors py-2.5 px-6 rounded-xl bg-red-950/30 border border-red-500/30 text-xs font-heading font-bold uppercase tracking-wider\"\n        >\n          <LogOut className=\"w-4 h-4\" />\n          <span>SIGN OUT</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
