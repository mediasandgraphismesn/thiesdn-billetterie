  planner_response {
    response: "Voici le script SQL complet et optimis\303\251 int\303\251grant le trigger automatique pour calculer et enregistrer instantan\303\251ment les transactions financi\303\250res (**90% Promoteur, 10% Plateforme Thi\303\250sDN, 1% Op\303\251rateur Mobile Money**) lors de la cr\303\251ation d\'un ticket.\n\n---\n\n### Script SQL Pr\303\252t \303\240 l\'Emploi (Console Supabase SQL Editor)\n\n```sql\n-- ====================================================================\n-- SCRIPT DE TEST DU FLUX BILLETTERIE & TRANSACTIONS AUTOMATIQUES\n-- ====================================================================\n\n-- 0. Pr\303\251-requis : S\'assurer que les tables et le trigger existent\nCREATE TABLE IF NOT EXISTS public.users (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  uid TEXT UNIQUE NOT NULL,\n  email TEXT,\n  phone TEXT,\n  pseudo TEXT,\n  role TEXT DEFAULT \'user\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS public.events (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  title TEXT NOT NULL,\n  category TEXT NOT NULL,\n  description TEXT,\n  event_date TIMESTAMP WITH TIME ZONE,\n  location TEXT,\n  affiche_url TEXT,\n  promoter_id TEXT,\n  promoter_name TEXT,\n  price NUMERIC DEFAULT 0,\n  status TEXT DEFAULT \'approved\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS public.tickets (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  event_id UUID REFERENCES public.events(id) ON DELETE CASCADE,\n  buyer_id TEXT,\n  qr_code TEXT UNIQUE NOT NULL,\n  payment_method TEXT DEFAULT \'wave\',\n  price NUMERIC,\n  status TEXT DEFAULT \'valid\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS public.transactions (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  ticket_id UUID REFERENCES public.tickets(id) ON DELETE SET NULL,\n  event_id UUID REFERENCES public.events(id) ON DELETE SET NULL,\n  buyer_id TEXT,\n  promoter_id TEXT,\n  promoter_name TEXT,\n  payment_method TEXT,\n  total_amount NUMERIC NOT NULL,\n  promoter_share NUMERIC NOT NULL, -- 90%\n  platform_fee NUMERIC NOT NULL,   -- 10%\n  operator_fee NUMERIC NOT NULL,   -- 1% Wave/OM\n  status TEXT DEFAULT \'completed\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\n-- Trigger pour g\303\251n\303\251rer automatiquement la transaction lors d\'un achat de ticket\nCREATE OR REPLACE FUNCTION public.process_ticket_transaction()\nRETURNS TRIGGER AS $$\nDECLARE\n  v_event public.events%ROWTYPE;\n  v_price NUMERIC;\nBEGIN\n  SELECT * INTO v_event FROM public.events WHERE id = NEW.event_id;\n  v_price := COALESCE(NEW.price, v_event.price, 0);\n\n  INSERT INTO public.transactions (\n    ticket_id,\n    event_id,\n    buyer_id,\n    promoter_id,\n    promoter_name,\n    payment_method,\n    total_amount,\n    promoter_share,\n    platform_fee,\n    operator_fee,\n    status\n  ) VALUES (\n    NEW.id,\n    NEW.event_id,\n    NEW.buyer_id,\n    v_event.promoter_id,\n    v_event.promoter_name,\n    NEW.payment_method,\n    v_price,\n    ROUND(v_price * 0.90), -- 90% pour le promoteur\n    ROUND(v_price * 0.10), -- 10% pour Thi\303\250sDN\n    ROUND(v_price * 0.01), -- 1% Frais Mobile Money\n    \'completed\'\n  );\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nDROP TRIGGER IF EXISTS trg_after_ticket_insert ON public.tickets;\nCREATE TRIGGER trg_after_ticket_insert\nAFTER INSERT ON public.tickets\nFOR EACH ROW EXECUTE FUNCTION public.process_ticket_transaction();\n\n-- ====================================================================\n-- 1. CR\303\211ER UN UTILISATEUR TEST (PROMOTEUR)\n-- ====================================================================\nINSERT INTO public.users (uid, email, phone, pseudo, role) \nVALUES (\'abc-123-def\', \'promoteur@thiesdn.com\', \'+221771234567\', \'PromoTest\', \'promoter\')\nON CONFLICT (uid) DO NOTHING;\n\n-- ====================================================================\n-- 2. AJOUTER L\'\303\211V\303\211NEMENT GALA THI\303\210S\n-- ====================================================================\nINSERT INTO public.events (\n    title, category, description, event_date, location, \n    affiche_url, promoter_id, promoter_name, price, status\n) VALUES (\n    \'\360\237\224\245 Gala de la Nuit - Thi\303\250s\',\n    \'gala\',\n    \'Soir\303\251e de gala exceptionnelle au Grand Th\303\251\303\242tre de Thi\303\250s\',\n    \'2024-12-25T20:00:00Z\',\n    \'Grand Th\303\251\303\242tre de Thi\303\250s\',\n    \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800\',\n    \'abc-123-def\',\n    \'PromoTest\',\n    15000,\n    \'approved\'\n);\n\n-- ====================================================================\n-- 3. CR\303\211ER UN TICKET (SIMULATION D\'ACHAT WAVE)\n-- ====================================================================\nINSERT INTO public.tickets (\n    event_id, buyer_id, qr_code, payment_method, price\n) VALUES (\n    (SELECT id FROM public.events WHERE title = \'\360\237\224\245 Gala de la Nuit - Thi\303\250s\' ORDER BY created_at DESC LIMIT 1),\n    \'abc-123-def\',\n    \'THIESDN-\' || gen_random_uuid()::text,\n    \'wave\',\n    15000\n);\n\n-- ====================================================================\n-- 4. V\303\211RIFIER LA TRANSACTION CR\303\211\303\211E AUTOMATIQUEMENT\n-- ====================================================================\nSELECT \n  id,\n  buyer_id,\n  promoter_name,\n  payment_method,\n  total_amount || \' FCFA\' AS montant_total,\n  promoter_share || \' FCFA (90%)\' AS part_promoteur,\n  platform_fee || \' FCFA (10%)\' AS commission_thiesdn,\n  operator_fee || \' FCFA (1%)\' AS frais_wave,\n  status,\n  created_at\nFROM public.transactions \nORDER BY created_at DESC \nLIMIT 1;\n```\n\n---\n\n### R\303\251sultat de la Transaction (SELECT #4)\n\n| Champ | Valeur | Description |\n|---|---|---|\n| **`total_amount`** | **15 000 FCFA** | Montant d\303\251bit\303\251 via Wave |\n| **`promoter_share`** | **13 500 FCFA** | **90%** revers\303\251 au promoteur `PromoTest` |\n| **`platform_fee`** | **1 500 FCFA** | **10%** commission plateforme Thi\303\250sDN |\n| **`operator_fee`** | **150 FCFA** | **1%** frais d\'op\303\251rateur r\303\251seau (Wave) |\n| **`payment_method`** | `wave` | M\303\251thode de paiement |\n| **`status`** | `completed` | Transaction valid\303\251e en direct |"
    modified_response: "Voici le script SQL complet et optimis\303\251 int\303\251grant le trigger automatique pour calculer et enregistrer instantan\303\251ment les transactions financi\303\250res (**90% Promoteur, 10% Plateforme Thi\303\250sDN, 1% Op\303\251rateur Mobile Money**) lors de la cr\303\251ation d\'un ticket.\n\n---\n\n### Script SQL Pr\303\252t \303\240 l\'Emploi (Console Supabase SQL Editor)\n\n```sql\n-- ====================================================================\n-- SCRIPT DE TEST DU FLUX BILLETTERIE & TRANSACTIONS AUTOMATIQUES\n-- ====================================================================\n\n-- 0. Pr\303\251-requis : S\'assurer que les tables et le trigger existent\nCREATE TABLE IF NOT EXISTS public.users (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  uid TEXT UNIQUE NOT NULL,\n  email TEXT,\n  phone TEXT,\n  pseudo TEXT,\n  role TEXT DEFAULT \'user\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS public.events (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  title TEXT NOT NULL,\n  category TEXT NOT NULL,\n  description TEXT,\n  event_date TIMESTAMP WITH TIME ZONE,\n  location TEXT,\n  affiche_url TEXT,\n  promoter_id TEXT,\n  promoter_name TEXT,\n  price NUMERIC DEFAULT 0,\n  status TEXT DEFAULT \'approved\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS public.tickets (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  event_id UUID REFERENCES public.events(id) ON DELETE CASCADE,\n  buyer_id TEXT,\n  qr_code TEXT UNIQUE NOT NULL,\n  payment_method TEXT DEFAULT \'wave\',\n  price NUMERIC,\n  status TEXT DEFAULT \'valid\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\nCREATE TABLE IF NOT EXISTS public.transactions (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  ticket_id UUID REFERENCES public.tickets(id) ON DELETE SET NULL,\n  event_id UUID REFERENCES public.events(id) ON DELETE SET NULL,\n  buyer_id TEXT,\n  promoter_id TEXT,\n  promoter_name TEXT,\n  payment_method TEXT,\n  total_amount NUMERIC NOT NULL,\n  promoter_share NUMERIC NOT NULL, -- 90%\n  platform_fee NUMERIC NOT NULL,   -- 10%\n  operator_fee NUMERIC NOT NULL,   -- 1% Wave/OM\n  status TEXT DEFAULT \'completed\',\n  created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL\n);\n\n-- Trigger pour g\303\251n\303\251rer automatiquement la transaction lors d\'un achat de ticket\nCREATE OR REPLACE FUNCTION public.process_ticket_transaction()\nRETURNS TRIGGER AS $$\nDECLARE\n  v_event public.events%ROWTYPE;\n  v_price NUMERIC;\nBEGIN\n  SELECT * INTO v_event FROM public.events WHERE id = NEW.event_id;\n  v_price := COALESCE(NEW.price, v_event.price, 0);\n\n  INSERT INTO public.transactions (\n    ticket_id,\n    event_id,\n    buyer_id,\n    promoter_id,\n    promoter_name,\n    payment_method,\n    total_amount,\n    promoter_share,\n    platform_fee,\n    operator_fee,\n    status\n  ) VALUES (\n    NEW.id,\n    NEW.event_id,\n    NEW.buyer_id,\n    v_event.promoter_id,\n    v_event.promoter_name,\n    NEW.payment_method,\n    v_price,\n    ROUND(v_price * 0.90), -- 90% pour le promoteur\n    ROUND(v_price * 0.10), -- 10% pour Thi\303\250sDN\n    ROUND(v_price * 0.01), -- 1% Frais Mobile Money\n    \'completed\'\n  );\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nDROP TRIGGER IF EXISTS trg_after_ticket_insert ON public.tickets;\nCREATE TRIGGER trg_after_ticket_insert\nAFTER INSERT ON public.tickets\nFOR EACH ROW EXECUTE FUNCTION public.process_ticket_transaction();\n\n-- ====================================================================\n-- 1. CR\303\211ER UN UTILISATEUR TEST (PROMOTEUR)\n-- ====================================================================\nINSERT INTO public.users (uid, email, phone, pseudo, role) \nVALUES (\'abc-123-def\', \'promoteur@thiesdn.com\', \'+221771234567\', \'PromoTest\', \'promoter\')\nON CONFLICT (uid) DO NOTHING;\n\n-- ====================================================================\n-- 2. AJOUTER L\'\303\211V\303\211NEMENT GALA THI\303\210S\n-- ====================================================================\nINSERT INTO public.events (\n    title, category, description, event_date, location, \n    affiche_url, promoter_id, promoter_name, price, status\n) VALUES (\n    \'\360\237\224\245 Gala de la Nuit - Thi\303\250s\',\n    \'gala\',\n    \'Soir\303\251e de gala exceptionnelle au Grand Th\303\251\303\242tre de Thi\303\250s\',\n    \'2024-12-25T20:00:00Z\',\n    \'Grand Th\303\251\303\242tre de Thi\303\250s\',\n    \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800\',\n    \'abc-123-def\',\n    \'PromoTest\',\n    15000,\n    \'approved\'\n);\n\n-- ====================================================================\n-- 3. CR\303\211ER UN TICKET (SIMULATION D\'ACHAT WAVE)\n-- ====================================================================\nINSERT INTO public.tickets (\n    event_id, buyer_id, qr_code, payment_method, price\n) VALUES (\n    (SELECT id FROM public.events WHERE title = \'\360\237\224\245 Gala de la Nuit - Thi\303\250s\' ORDER BY created_at DESC LIMIT 1),\n    \'abc-123-def\',\n    \'THIESDN-\' || gen_random_uuid()::text,\n    \'wave\',\n    15000\n);\n\n-- ====================================================================\n-- 4. V\303\211RIFIER LA TRANSACTION CR\303\211\303\211E AUTOMATIQUEMENT\n-- ====================================================================\nSELECT \n  id,\n  buyer_id,\n  promoter_name,\n  payment_method,\n  total_amount || \' FCFA\' AS montant_total,\n  promoter_share || \' FCFA (90%)\' AS part_promoteur,\n  platform_fee || \' FCFA (10%)\' AS commission_thiesdn,\n  operator_fee || \' FCFA (1%)\' AS frais_wave,\n  status,\n  created_at\nFROM public.transactions \nORDER BY created_at DESC \nLIMIT 1;\n```\n\n---\n\n### R\303\251sultat de la Transaction (SELECT #4)\n\n| Champ | Valeur | Description |\n|---|---|---|\n| **`total_amount`** | **15 000 FCFA** | Montant d\303\251bit\303\251 via Wave |\n| **`promoter_share`** | **13 500 FCFA** | **90%** revers\303\251 au promoteur `PromoTest` |\n| **`platform_fee`** | **1 500 FCFA** | **10%** commission plateforme Thi\303\250sDN |\n| **`operator_fee`** | **150 FCFA** | **1%** frais d\'op\303\251rateur r\303\251seau (Wave) |\n| **`payment_method`** | `wave` | M\303\251thode de paiement |\n| **`status`** | `completed` | Transaction valid\303\251e en direct |"
