    replacement_chunks {
      replacement_content: "import { createClient } from \'@supabase/supabase-js\';\n\n// Read from process.env or .env file\nconst supabaseUrl = process.env.VITE_SUPABASE_URL || process.env.SUPABASE_URL || \'\';\nconst supabaseAnonKey = process.env.VITE_SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY || \'\';\n\nconsole.log(\'=== TEST DE CONNEXION SUPABASE ===\');\nconsole.log(\'URL Configur\303\251e:\', supabaseUrl ? (supabaseUrl.slice(0, 20) + \'...\') : \'NON D\303\211FINIE\');\nconsole.log(\'Cl\303\251 Configur\303\251e:\', supabaseAnonKey ? (supabaseAnonKey.slice(0, 15) + \'...\') : \'NON D\303\211FINIE\');\n\nasync function testSupabase() {\n  if (!supabaseUrl || !supabaseAnonKey || supabaseUrl.includes(\'your-project\') || supabaseUrl.includes(\'xyzcompany\')) {\n    console.error(\'\342\235\214 ERREUR : Les variables VITE_SUPABASE_URL et VITE_SUPABASE_ANON_KEY ne sont pas renseign\303\251es ou utilisent des valeurs placeholders.\');\n    return;\n  }\n\n  const supabase = createClient(supabaseUrl, supabaseAnonKey);\n\n  console.log(\'\\n1. Interrogation de la table \"events\" (status = \"approved\")...\');\n  const { data: events, error } = await supabase\n    .from(\'events\')\n    .select(\'*\')\n    .eq(\'status\', \'approved\');\n\n  if (error) {\n    console.error(\'\342\235\214 Erreur lors de la requ\303\252te Supabase :\', error.message);\n    return;\n  }\n\n  console.log(`Donn\303\251es re\303\247ues : ${events?.length || 0} \303\251v\303\251nement(s) trouv\303\251(s).`);\n\n  if (!events || events.length === 0) {\n    console.log(\'\\n2. La table \"events\" est vide. Insertion des 2 \303\251v\303\251nements de test (Thi\303\250s et Mbour)...\');\n\n    const testEvents = [\n      {\n        title: \'Nuit du Baobab Prestige - Thi\303\250s\',\n        category: \'nightlife\',\n        description: \'Soir\303\251e exceptionnelle au Grand Th\303\251\303\242tre de Thi\303\250s avec les plus grands artistes\',\n        event_date: \'2024-10-25T21:30:00Z\',\n        location: \'Grand Th\303\251\303\242tre de Thi\303\250s, Thi\303\250s, S\303\251n\303\251gal\',\n        affiche_url: \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800\',\n        promoter_name: \'Promoteur Test Thi\303\250s\',\n        price: 5000,\n        status: \'approved\',\n      },\n      {\n        title: \'Mbour Afro-Fusion & Mbalax Live\',\n        category: \'concert\',\n        description: \'Soir\303\251e Afro-Fusion au Mbour Night Lounge avec les meilleurs DJ\',\n        event_date: \'2024-10-28T22:00:00Z\',\n        location: \'Mbour Night Lounge, Bord de Mer, Mbour\',\n        affiche_url: \'https://images.unsplash.com/photo-1506157786151-b8491531f063?w=800\',\n        promoter_name: \'Promoteur Test Mbour\',\n        price: 3000,\n        status: \'approved\',\n      },\n    ];\n\n    const { data: inserted, error: insertError } = await supabase\n      .from(\'events\')\n      .insert(testEvents)\n      .select();\n\n    if (insertError) {\n      console.error(\'\342\235\214 Erreur lors de l\\\'insertion :\', insertError.message);\n      // Let\'s also try with column name variations in case table schema uses date/venue instead of event_date/location\n      console.log(\'Tentative d\\\'insertion avec les colonnes alternatives (venue, datetime_iso, poster_url)...\');\n      const altEvents = [\n        {\n          title: \'Nuit du Baobab Prestige - Thi\303\250s\',\n          category: \'nightlife\',\n          description: \'Soir\303\251e exceptionnelle au Grand Th\303\251\303\242tre de Thi\303\250s avec les plus grands artistes\',\n          date: \'25 Octobre 2024\',\n          time: \'21:30\',\n          datetime_iso: \'2024-10-25T21:30:00Z\',\n          venue: \'Grand Th\303\251\303\242tre de Thi\303\250s, Thi\303\250s, S\303\251n\303\251gal\',\n          city: \'Thi\303\250s\',\n          poster_url: \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800\',\n          promoter_name: \'Promoteur Test Thi\303\250s\',\n          price: 5000,\n          status: \'approved\',\n        },\n        {\n          title: \'Mbour Afro-Fusion & Mbalax Live\',\n          category: \'concert\',\n          description: \'Soir\303\251e Afro-Fusion au Mbour Night Lounge avec les meilleurs DJ\',\n          date: \'28 Octobre 2024\',\n          time: \'22:00\',\n          datetime_iso: \'2024-10-28T22:00:00Z\',\n          venue: \'Mbour Night Lounge, Bord de Mer, Mbour\',\n          city: \'Mbour\',\n          poster_url: \'https://images.unsplash.com/photo-1506157786151-b8491531f063?w=800\',\n          promoter_name: \'Promoteur Test Mbour\',\n          price: 3000,\n          status: \'approved\',\n        },\n      ];\n      const { data: altInserted, error: altError } = await supabase\n        .from(\'events\')\n        .insert(altEvents)\n        .select();\n\n      if (altError) {\n        console.error(\'\342\235\214 Erreur alternative :\', altError.message);\n      } else {\n        console.log(\'\342\234\205 \303\211v\303\251nements ins\303\251r\303\251s avec succ\303\250s :\', altInserted);\n        console.log(`\\n\342\234\205 Connexion Supabase r\303\251ussie ! ${altInserted?.length || 2} \303\251v\303\251nements trouv\303\251s`);\n      }\n    } else {\n      console.log(\'\342\234\205 \303\211v\303\251nements ins\303\251r\303\251s avec succ\303\250s :\');\n      console.table(inserted);\n      console.log(`\\n\342\234\205 Connexion Supabase r\303\251ussie ! ${inserted?.length || 2} \303\251v\303\251nements trouv\303\251s`);\n    }\n  } else {\n    console.log(\'\\n\303\211v\303\251nements trouv\303\251s dans la base Supabase :\');\n    console.table(events);\n    console.log(`\\n\342\234\205 Connexion Supabase r\303\251ussie ! ${events.length} \303\251v\303\251nements trouv\303\251s`);\n  }\n}\n\ntestSupabase().catch(console.error);\n"
    }
