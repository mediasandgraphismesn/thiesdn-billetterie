        target_content: "            <div className=\"flex items-center gap-3 pt-2\">\n              <button\n                type=\"submit\"\n                className=\"btn-primary-glow py-2.5 px-5 rounded-xl text-xs font-heading font-bold uppercase tracking-wider flex items-center gap-2\"\n              >\n                <Key className=\"w-3.5 h-3.5\" />\n                <span>Enregistrer & Tester</span>\n              </button>\n\n              {connectionSaved && (\n                <span className=\"text-xs text-emerald-400 font-bold flex items-center gap-1\">\n                  <Check className=\"w-4 h-4\" /> Param\303\250tres enregistr\303\251s !\n                </span>\n              )}\n            </div>\n          </form>"
        replacement_content: "            <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n              <button\n                type=\"submit\"\n                className=\"btn-primary-glow py-2.5 px-4 rounded-xl text-xs font-heading font-bold uppercase tracking-wider flex items-center gap-2\"\n              >\n                <Key className=\"w-3.5 h-3.5\" />\n                <span>Enregistrer</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleTestSupabaseLive}\n                disabled={isTestingSupabase}\n                className=\"px-4 py-2.5 rounded-xl bg-[#8A2BE2]/20 hover:bg-[#8A2BE2]/40 text-[#DCB8FF] border border-[#8A2BE2]/40 text-xs font-bold flex items-center gap-2 transition-all disabled:opacity-50\"\n              >\n                <RefreshCw className={`w-3.5 h-3.5 ${isTestingSupabase ? \'animate-spin\' : \'\'}`} />\n                <span>Tester Requ\303\252te \'events\'</span>\n              </button>\n\n              {connectionSaved && (\n                <span className=\"text-xs text-emerald-400 font-bold flex items-center gap-1\">\n                  <Check className=\"w-4 h-4\" /> Enregistr\303\251 !\n                </span>\n              )}\n            </div>\n          </form>\n\n          {/* Live Query Test Feedback */}\n          {testResult && (\n            <div className={`p-4 rounded-2xl border text-xs space-y-2 mt-4 ${\n              testResult.success\n                ? \'bg-emerald-950/40 border-emerald-500/30 text-emerald-300\'\n                : \'bg-rose-950/40 border-rose-500/30 text-rose-300\'\n            }`}>\n              <div className=\"font-bold flex items-center gap-2\">\n                <span>{testResult.message}</span>\n              </div>\n\n              {testResult.error && (\n                <p className=\"text-[11px] text-gray-300 bg-black/40 p-2.5 rounded-lg border border-white/5 font-mono\">\n                  {testResult.error}\n                </p>\n              )}\n\n              {testResult.events && testResult.events.length > 0 && (\n                <div className=\"mt-2 space-y-1.5\">\n                  <div className=\"font-bold text-white text-[11px] uppercase tracking-wider\">\n                    \303\211v\303\251nements trouv\303\251s ({testResult.events.length}) :\n                  </div>\n                  <div className=\"max-h-40 overflow-y-auto space-y-1 pr-1 font-mono text-[11px]\">\n                    {testResult.events.map((evt: any, i: number) => (\n                      <div key={i} className=\"p-2 rounded bg-black/50 border border-white/10 flex items-center justify-between\">\n                        <div>\n                          <div className=\"font-bold text-white\">{evt.title}</div>\n                          <div className=\"text-[10px] text-gray-400\">{evt.location || evt.venue} \342\200\242 {evt.price} FCFA</div>\n                        </div>\n                        <span className=\"px-2 py-0.5 rounded bg-[#8A2BE2]/30 text-[#DCB8FF] text-[10px] font-bold\">\n                          {evt.status}\n                        </span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              )}\n            </div>\n          )}"
      }
      num_matches: 1
    }
  }
}
