  file_change {
    absolute_path_uri: "file:///src/views/ModerationView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  Search,\n  Filter,\n  ArrowUpDown,\n  Check,\n  X,\n  Calendar,\n  MapPin,\n  ShieldCheck,\n  Sparkles,\n  AlertTriangle,\n  CheckCircle2,\n  Eye,\n  SlidersHorizontal,\n} from \'lucide-react\';\nimport { EventItem } from \'../types\';\n\ninterface ModerationViewProps {\n  events: EventItem[];\n  onApproveEvent: (eventId: string) => void;\n  onRejectEvent: (eventId: string, reason?: string) => void;\n  onPreviewEvent: (event: EventItem) => void;\n}\n\nexport const ModerationView: React.FC<ModerationViewProps> = ({\n  events,\n  onApproveEvent,\n  onRejectEvent,\n  onPreviewEvent,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [filterCategory, setFilterCategory] = useState(\'All\');\n  const [rejectingEvent, setRejectingEvent] = useState<EventItem | null>(null);\n  const [rejectionReason, setRejectionReason] = useState(\'Informations de lieu incompl\303\250tes\');\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const pendingEvents = events.filter((e) => e.status === \'pending\');\n\n  const filteredPending = pendingEvents.filter((e) => {\n    const matchesSearch =\n      e.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      e.promoter.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      e.venue.toLowerCase().includes(searchQuery.toLowerCase());\n\n    const matchesCat = filterCategory === \'All\' || e.category === filterCategory;\n\n    return matchesSearch && matchesCat;\n  });\n\n  const handleApprove = (e: React.MouseEvent, event: EventItem) => {\n    e.stopPropagation();\n    onApproveEvent(event.id);\n    setToastMessage(`L\342\200\231\303\251v\303\251nement \"${event.title}\" a \303\251t\303\251 approuv\303\251 et publi\303\251 !`);\n    setTimeout(() => setToastMessage(null), 3000);\n  };\n\n  const handleConfirmReject = () => {\n    if (!rejectingEvent) return;\n    onRejectEvent(rejectingEvent.id, rejectionReason);\n    setToastMessage(`L\342\200\231\303\251v\303\251nement \"${rejectingEvent.title}\" a \303\251t\303\251 rejet\303\251.`);\n    setRejectingEvent(null);\n    setTimeout(() => setToastMessage(null), 3000);\n  };\n\n  return (\n    <div className=\"space-y-6 pb-16 animate-in fade-in duration-300\">\n      {/* Toast alert */}\n      {toastMessage && (\n        <div className=\"fixed top-20 right-6 z-50 p-4 rounded-2xl bg-[#1C1B1B] border border-[#8A2BE2] shadow-2xl text-white flex items-center gap-3 animate-in slide-in-from-top-4 duration-300\">\n          <CheckCircle2 className=\"w-5 h-5 text-emerald-400\" />\n          <span className=\"text-sm font-semibold\">{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Page Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-3\">\n        <div>\n          <h1 className=\"font-heading text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n            Mod\303\251ration\n          </h1>\n          <p className=\"text-sm text-gray-400 mt-1\">\n            {pendingEvents.length} \303\251v\303\251nement(s) en attente de validation administrative\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          {pendingEvents.length > 1 && (\n            <button\n              onClick={() => {\n                pendingEvents.forEach((ev) => onApproveEvent(ev.id));\n                setToastMessage(\'Tous les \303\251v\303\251nements en attente ont \303\251t\303\251 valid\303\251s !\');\n                setTimeout(() => setToastMessage(null), 3000);\n              }}\n              className=\"px-3.5 py-2 rounded-xl bg-[#8A2BE2]/20 hover:bg-[#8A2BE2] text-[#DCB8FF] hover:text-white border border-[#8A2BE2]/40 text-xs font-bold transition-all flex items-center gap-1.5\"\n            >\n              <Check className=\"w-4 h-4\" />\n              <span>Tout Valider ({pendingEvents.length})</span>\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Search and Filter Bar matching Image 25 */}\n      <div className=\"bg-[#1C1B1B] rounded-2xl p-4 border border-white/10 shadow-lg space-y-3 sm:space-y-0 sm:flex sm:items-center sm:gap-4 sm:justify-between\">\n        <div className=\"relative flex-1 flex items-center bg-[#131313] border border-white/10 rounded-xl px-3.5 py-2.5 focus-within:border-[#8A2BE2] transition-colors\">\n          <Search className=\"w-4 h-4 text-gray-400 mr-2.5 flex-shrink-0\" />\n          <input\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            placeholder=\"Search events, promoters, users...\"\n            className=\"w-full bg-transparent border-none outline-none text-xs sm:text-sm text-white placeholder-gray-500 focus:ring-0 p-0\"\n          />\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <select\n            value={filterCategory}\n            onChange={(e) => setFilterCategory(e.target.value)}\n            className=\"bg-[#131313] border border-white/10 rounded-xl px-3 py-2 text-xs font-semibold text-white focus:outline-none focus:border-[#8A2BE2] cursor-pointer\"\n          >\n            <option value=\"All\">Toutes Cat\303\251gories</option>\n            <option value=\"Concert\">Concert</option>\n            <option value=\"Bo\303\256te de nuit\">Bo\303\256te de nuit</option>\n            <option value=\"VIP Lounge\">VIP Lounge</option>\n            <option value=\"Gala\">Gala</option>\n            <option value=\"Festival\">Festival</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Pending Moderation Count Indicator */}\n      <div className=\"flex items-center justify-between\">\n        <h2 className=\"font-heading text-lg font-bold text-white flex items-center gap-2\">\n          <span>\303\211v\303\251nements Soumis</span>\n        </h2>\n        <span className=\"bg-[#8A2BE2]/20 text-[#DCB8FF] border border-[#8A2BE2]/40 text-xs font-bold px-3 py-1 rounded-full\">\n          {filteredPending.length} En attente\n        </span>\n      </div>\n\n      {/* Moderation Grid / Cards matching Image 25 */}\n      {filteredPending.length === 0 ? (\n        <div className=\"glass-panel p-12 rounded-3xl text-center space-y-4\">\n          <div className=\"w-16 h-16 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center mx-auto border border-emerald-500/30\">\n            <CheckCircle2 className=\"w-8 h-8\" />\n          </div>\n          <div>\n            <h3 className=\"font-heading text-lg font-bold text-white\">\n              File de mod\303\251ration vide\n            </h3>\n            <p className=\"text-xs text-gray-400 mt-1 max-w-sm mx-auto\">\n              Tous les \303\251v\303\251nements soumis ont \303\251t\303\251 examin\303\251s. Les nouveaux \303\251v\303\251nements cr\303\251\303\251s appara\303\256tront instantan\303\251ment ici.\n            </p>\n          </div>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {filteredPending.map((event) => (\n            <article\n              key={event.id}\n              onClick={() => onPreviewEvent(event)}\n              className=\"glass-panel rounded-2xl overflow-hidden flex flex-col justify-between group hover:border-[#8A2BE2]/50 hover:-translate-y-1 transition-all duration-300 cursor-pointer shadow-xl relative\"\n            >\n              {/* Poster header */}\n              <div className=\"h-48 relative overflow-hidden flex-shrink-0\">\n                <img\n                  src={event.posterUrl}\n                  alt={event.title}\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent\" />\n\n                {/* Status Badge Pulse top-left matching Image 25 */}\n                <div className=\"absolute top-3 left-3 bg-[#E9C349]/90 text-[#241A00] px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider flex items-center gap-1.5 shadow-lg\">\n                  <span className=\"w-2 h-2 rounded-full bg-[#241A00] animate-pulse\" />\n                  <span>En attente</span>\n                </div>\n\n                {/* Price Tag top-right */}\n                <div className=\"absolute top-3 right-3 bg-[#1C1B1B]/90 backdrop-blur-md px-2.5 py-1 rounded-lg text-xs font-extrabold text-[#E9C349] border border-white/10 shadow-md\">\n                  {event.price.toLocaleString(\'fr-FR\')} FCFA\n                </div>\n\n                {/* Event Category & Title */}\n                <div className=\"absolute bottom-3 inset-x-3 text-white\">\n                  <span className=\"text-[10px] font-extrabold uppercase tracking-widest text-[#E9C349] block mb-0.5\">\n                    {event.category}\n                  </span>\n                  <h3 className=\"font-heading text-base font-bold line-clamp-1 group-hover:text-[#DCB8FF] transition-colors\">\n                    {event.title}\n                  </h3>\n                </div>\n              </div>\n\n              {/* Event Content & Metadata */}\n              <div className=\"p-4 flex-1 flex flex-col justify-between space-y-4\">\n                <div className=\"space-y-2 text-xs text-gray-300\">\n                  <div className=\"flex items-center gap-2\">\n                    <Calendar className=\"w-3.5 h-3.5 text-[#DCB8FF] flex-shrink-0\" />\n                    <span>{event.date} \342\200\242 {event.time}</span>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <MapPin className=\"w-3.5 h-3.5 text-[#E9C349] flex-shrink-0\" />\n                    <span className=\"truncate\">{event.venue}, {event.city}</span>\n                  </div>\n\n                  {/* Promoter info bar matching Image 25 */}\n                  <div className=\"flex items-center gap-2.5 pt-2 border-t border-white/5\">\n                    <img\n                      src={event.promoter.avatar}\n                      alt={event.promoter.name}\n                      className=\"w-7 h-7 rounded-full object-cover border border-[#8A2BE2]/40\"\n                    />\n                    <div className=\"min-w-0\">\n                      <p className=\"font-semibold text-white truncate text-xs\">\n                        {event.promoter.name}\n                      </p>\n                      <p className=\"text-[10px] text-[#DCB8FF]\">\n                        {event.promoter.role || \'Promoteur\'}\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Moderation Actions matching Image 25: Reject & Approve */}\n                <div className=\"flex items-center gap-2 pt-2 border-t border-white/5\">\n                  <button\n                    onClick={(e) => {\n                      e.stopPropagation();\n                      setRejectingEvent(event);\n                    }}\n                    className=\"flex-1 py-2.5 px-3 rounded-xl bg-[#1C1B1B] hover:bg-red-500/20 text-red-400 border border-red-500/30 text-xs font-bold flex items-center justify-center gap-1.5 transition-all\"\n                  >\n                    <X className=\"w-3.5 h-3.5\" />\n                    <span>Rejeter</span>\n                  </button>\n\n                  <button\n                    onClick={(e) => handleApprove(e, event)}\n                    className=\"flex-1 py-2.5 px-3 rounded-xl bg-[#8A2BE2] hover:bg-[#7822c9] text-white text-xs font-bold flex items-center justify-center gap-1.5 transition-all shadow-md shadow-[#8A2BE2]/30\"\n                  >\n                    <Check className=\"w-3.5 h-3.5\" />\n                    <span>Valider</span>\n                  </button>\n                </div>\n              </div>\n            </article>\n          ))}\n        </div>\n      )}\n\n      {/* Reject Modal dialog */}\n      {rejectingEvent && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"w-full max-w-md bg-[#1C1B1B] border border-white/10 rounded-3xl p-6 space-y-4 shadow-2xl\">\n            <div className=\"flex items-center gap-3 text-red-400\">\n              <div className=\"p-2 rounded-xl bg-red-500/10 border border-red-500/20\">\n                <AlertTriangle className=\"w-5 h-5\" />\n              </div>\n              <h3 className=\"font-heading font-bold text-lg text-white\">\n                Rejeter l\342\200\231\303\251v\303\251nement\n              </h3>\n            </div>\n\n            <p className=\"text-xs text-gray-300\">\n              Veuillez indiquer le motif du rejet pour l\'organisateur de <span className=\"text-white font-bold\">{rejectingEvent.title}</span> :\n            </p>\n\n            <div className=\"space-y-2\">\n              {[\n                \'Affiche non conforme ou basse r\303\251solution\',\n                \'Informations de lieu ou GPS incompl\303\250tes\',\n                \'Tarification ou coordonn\303\251es WhatsApp invalides\',\n                \'Non-respect des r\303\250gles de la plateforme Thiesdn\',\n              ].map((reason) => (\n                <label\n                  key={reason}\n                  onClick={() => setRejectionReason(reason)}\n                  className={`flex items-center gap-3 p-3 rounded-xl border text-xs cursor-pointer transition-all ${\n                    rejectionReason === reason\n                      ? \'bg-red-500/10 border-red-500 text-white font-semibold\'\n                      : \'bg-[#141414] border-white/5 text-gray-400 hover:border-white/20\'\n                  }`}\n                >\n                  <input\n                    type=\"radio\"\n                    name=\"reason\"\n                    checked={rejectionReason === reason}\n                    onChange={() => setRejectionReason(reason)}\n                    className=\"text-[#8A2BE2] focus:ring-0\"\n                  />\n                  <span>{reason}</span>\n                </label>\n              ))}\n            </div>\n\n            <div className=\"flex items-center gap-3 pt-3\">\n              <button\n                onClick={() => setRejectingEvent(null)}\n                className=\"flex-1 py-2.5 rounded-xl bg-[#2A2A2A] text-gray-300 hover:text-white text-xs font-bold transition-colors\"\n              >\n                Annuler\n              </button>\n              <button\n                onClick={handleConfirmReject}\n                className=\"flex-1 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold transition-colors shadow-lg shadow-red-600/30\"\n              >\n                Confirmer le Rejet\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
