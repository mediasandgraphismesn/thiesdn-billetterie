    replacement_chunks {
      replacement_content: "import { createClient } from \'@supabase/supabase-js\';\n\n// Normalisation intelligente de l\'URL Supabase\nfunction formatSupabaseUrl(url: string): string {\n  let cleaned = url.trim();\n  if (!cleaned.startsWith(\'http://\') && !cleaned.startsWith(\'https://\')) {\n    cleaned = `https://${cleaned}`;\n  }\n  // Enlever /rest/v1 ou trailing slashes si l\'utilisateur a coll\303\251 l\'URL REST au lieu de l\'URL du projet\n  cleaned = cleaned.replace(/\\/rest\\/v1\\/?$/, \'\');\n  cleaned = cleaned.replace(/\\/+$/, \'\');\n  return cleaned;\n}\n\nconst rawUrl = process.env.VITE_SUPABASE_URL || process.env.SUPABASE_URL || \'\';\nconst rawKey = process.env.VITE_SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY || \'\';\n\nconst supabaseUrl = formatSupabaseUrl(rawUrl);\nconst supabaseAnonKey = rawKey.trim();\n\nconsole.log(\'=== TEST DE CONNEXION SUPABASE ===\');\nconsole.log(\'URL de Base du Projet :\', supabaseUrl);\nconsole.log(\'Cl\303\251 Publique / Anon :\', supabaseAnonKey.slice(0, 18) + \'...\');\n\nasync function testSupabase() {\n  const supabase = createClient(supabaseUrl, supabaseAnonKey);\n\n  console.log(\'\\n2. Requ\303\252te sur la table \"events\" avec le filtre status = \"approved\"...\');\n  const { data: events, error } = await supabase\n    .from(\'events\')\n    .select(\'*\')\n    .eq(\'status\', \'approved\');\n\n  if (error) {\n    console.error(\'\342\235\214 Erreur lors de la requ\303\252te :\', error.message);\n    console.error(\'D\303\251tails :\', error);\n    return;\n  }\n\n  console.log(`\\nNombre d\'\303\251v\303\251nements existants trouv\303\251s : ${events?.length || 0}`);\n\n  let currentEvents = events || [];\n\n  // 4. Si la table est vide, cr\303\251e 2 \303\251v\303\251nements de test\n  if (currentEvents.length === 0) {\n    console.log(\'\\n3. La table est vide. Cr\303\251ation des 2 \303\251v\303\251nements de test (Thi\303\250s et Mbour)...\');\n\n    const testEvents = [\n      {\n        title: \'Nuit du Baobab Prestige - Thi\303\250s\',\n        category: \'nightlife\',\n        description: \'Soir\303\251e exceptionnelle au Grand Th\303\251\303\242tre de Thi\303\250s avec les plus grands artistes\',\n        event_date: \'2024-10-25T21:30:00Z\',\n        location: \'Grand Th\303\251\303\242tre de Thi\303\250s, Thi\303\250s, S\303\251n\303\251gal\',\n        affiche_url: \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800\',\n        promoter_name: \'Promoteur Test Thi\303\250s\',\n        price: 5000,\n        status: \'approved\',\n      },\n      {\n        title: \'Mbour Afro-Fusion & Mbalax Live\',\n        category: \'concert\',\n        description: \'Soir\303\251e Afro-Fusion au Mbour Night Lounge avec les meilleurs DJ\',\n        event_date: \'2024-10-28T22:00:00Z\',\n        location: \'Mbour Night Lounge, Bord de Mer, Mbour\',\n        affiche_url: \'https://images.unsplash.com/photo-1506157786151-b8491531f063?w=800\',\n        promoter_name: \'Promoteur Test Mbour\',\n        price: 3000,\n        status: \'approved\',\n      },\n    ];\n\n    const { data: inserted, error: insertError } = await supabase\n      .from(\'events\')\n      .insert(testEvents)\n      .select();\n\n    if (insertError) {\n      console.error(\'\342\235\214 Erreur lors de l\\\'insertion :\', insertError.message);\n      // Tentative avec les colonnes alternatives si la table a \303\251t\303\251 cr\303\251\303\251e avec le sch\303\251ma complet\n      console.log(\'Tentative avec colonnes standard...\');\n      const fallbackEvents = [\n        {\n          title: \'Nuit du Baobab Prestige - Thi\303\250s\',\n          category: \'nightlife\',\n          description: \'Soir\303\251e exceptionnelle au Grand Th\303\251\303\242tre de Thi\303\250s avec les plus grands artistes\',\n          date: \'25 Octobre 2024\',\n          time: \'21:30\',\n          datetime_iso: \'2024-10-25T21:30:00Z\',\n          venue: \'Grand Th\303\251\303\242tre de Thi\303\250s, Thi\303\250s, S\303\251n\303\251gal\',\n          city: \'Thi\303\250s\',\n          poster_url: \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=800\',\n          promoter_name: \'Promoteur Test Thi\303\250s\',\n          price: 5000,\n          status: \'approved\',\n        },\n        {\n          title: \'Mbour Afro-Fusion & Mbalax Live\',\n          category: \'concert\',\n          description: \'Soir\303\251e Afro-Fusion au Mbour Night Lounge avec les meilleurs DJ\',\n          date: \'28 Octobre 2024\',\n          time: \'22:00\',\n          datetime_iso: \'2024-10-28T22:00:00Z\',\n          venue: \'Mbour Night Lounge, Bord de Mer, Mbour\',\n          city: \'Mbour\',\n          poster_url: \'https://images.unsplash.com/photo-1506157786151-b8491531f063?w=800\',\n          promoter_name: \'Promoteur Test Mbour\',\n          price: 3000,\n          status: \'approved\',\n        },\n      ];\n      const { data: fallbackInserted, error: fallbackError } = await supabase\n        .from(\'events\')\n        .insert(fallbackEvents)\n        .select();\n\n      if (fallbackError) {\n        console.error(\'\342\235\214 Erreur fallback :\', fallbackError.message);\n      } else {\n        currentEvents = fallbackInserted || [];\n      }\n    } else {\n      currentEvents = inserted || [];\n    }\n  }\n\n  // 3. Affiche le r\303\251sultat dans un tableau lisible\n  console.log(\'\\n=== R\303\211SULTAT DU TABLEAU \"events\" ===\');\n  console.table(\n    currentEvents.map((e: any) => ({\n      ID: e.id || \'N/A\',\n      Titre: e.title,\n      Cat\303\251gorie: e.category,\n      Date: e.event_date || e.date || e.datetime_iso,\n      Lieu: e.location || e.venue,\n      Promoteur: e.promoter_name,\n      Prix: `${e.price} FCFA`,\n      Statut: e.status,\n    }))\n  );\n\n  // 5. R\303\251sum\303\251 final\n  console.log(`\\n\342\234\205 Connexion Supabase r\303\251ussie ! ${currentEvents.length} \303\251v\303\251nements trouv\303\251s`);\n}\n\ntestSupabase();\n"
    }
