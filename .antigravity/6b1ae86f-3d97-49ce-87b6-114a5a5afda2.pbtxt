  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Header } from \'./components/Header\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { BottomNav } from \'./components/BottomNav\';\nimport { ShaderBackground } from \'./components/ShaderBackground\';\nimport { EventDetailModal } from \'./components/EventDetailModal\';\nimport { TicketPassModal } from \'./components/TicketPassModal\';\n\nimport { HomeView } from \'./views/HomeView\';\nimport { ExploreView } from \'./views/ExploreView\';\nimport { CreateEventView } from \'./views/CreateEventView\';\nimport { ModerationView } from \'./views/ModerationView\';\nimport { ProfileView } from \'./views/ProfileView\';\nimport { AuthView } from \'./views/AuthView\';\nimport { CheckInScannerView } from \'./views/CheckInScannerView\';\nimport { TicketsWalletView } from \'./views/TicketsWalletView\';\n\nimport {\n  INITIAL_USER,\n  INITIAL_EVENTS,\n  INITIAL_TICKETS,\n  INITIAL_NOTIFICATIONS,\n} from \'./data/mockEvents\';\nimport { EventItem, UserProfile, UserTicket, NotificationItem } from \'./types\';\n\nexport default function App() {\n  const [isAuthenticated, setIsAuthenticated] = useState(true);\n  const [user, setUser] = useState<UserProfile>(INITIAL_USER);\n  const [events, setEvents] = useState<EventItem[]>(INITIAL_EVENTS);\n  const [tickets, setTickets] = useState<UserTicket[]>(INITIAL_TICKETS);\n  const [notifications, setNotifications] = useState<NotificationItem[]>(INITIAL_NOTIFICATIONS);\n\n  const [activeTab, setActiveTab] = useState<string>(\'home\');\n  const [currentRole, setCurrentRole] = useState<\'user\' | \'promoter\' | \'admin\'>(\'admin\');\n  const [ambientShader, setAmbientShader] = useState<boolean>(true);\n\n  const [selectedEventForDetail, setSelectedEventForDetail] = useState<EventItem | null>(null);\n  const [selectedTicketForPass, setSelectedTicketForPass] = useState<UserTicket | null>(null);\n\n  // Count pending moderation events\n  const pendingModerationCount = events.filter((e) => e.status === \'pending\').length;\n\n  const handleLoginSuccess = (role: \'user\' | \'promoter\' | \'admin\' = \'admin\') => {\n    setIsAuthenticated(true);\n    setCurrentRole(role);\n    setUser((prev) => ({\n      ...prev,\n      role,\n    }));\n  };\n\n  const handleSignOut = () => {\n    setIsAuthenticated(false);\n  };\n\n  const handleCreateEvent = (newEvent: EventItem) => {\n    setEvents((prev) => [newEvent, ...prev]);\n\n    // Add notification\n    const newNotif: NotificationItem = {\n      id: `notif-${Date.now()}`,\n      title: \'Nouvel \303\211v\303\251nement Soumis\',\n      message: `Votre \303\251v\303\251nement \"${newEvent.title}\" a \303\251t\303\251 soumis pour mod\303\251ration administrative.`,\n      timestamp: \'\303\200 l\342\200\231instant\',\n      read: false,\n      type: \'moderation\',\n    };\n    setNotifications((prev) => [newNotif, ...prev]);\n  };\n\n  const handleApproveEvent = (eventId: string) => {\n    setEvents((prev) =>\n      prev.map((evt) =>\n        evt.id === eventId ? { ...evt, status: \'approved\' as const } : evt\n      )\n    );\n\n    const targetEvent = events.find((e) => e.id === eventId);\n    if (targetEvent) {\n      const newNotif: NotificationItem = {\n        id: `notif-${Date.now()}`,\n        title: \'\303\211v\303\251nement Approuv\303\251\',\n        message: `L\'\303\251v\303\251nement \"${targetEvent.title}\" est d\303\251sormais disponible \303\240 la vente.`,\n        timestamp: \'\303\200 l\342\200\231instant\',\n        read: false,\n        type: \'event\',\n      };\n      setNotifications((prev) => [newNotif, ...prev]);\n    }\n  };\n\n  const handleRejectEvent = (eventId: string, reason?: string) => {\n    setEvents((prev) =>\n      prev.map((evt) =>\n        evt.id === eventId ? { ...evt, status: \'rejected\' as const } : evt\n      )\n    );\n\n    const targetEvent = events.find((e) => e.id === eventId);\n    if (targetEvent) {\n      const newNotif: NotificationItem = {\n        id: `notif-${Date.now()}`,\n        title: \'\303\211v\303\251nement Rejet\303\251\',\n        message: `L\'\303\251v\303\251nement \"${targetEvent.title}\" a \303\251t\303\251 refus\303\251 : ${reason || \'Non-conformit\303\251\'}.`,\n        timestamp: \'\303\200 l\342\200\231instant\',\n        read: false,\n        type: \'moderation\',\n      };\n      setNotifications((prev) => [newNotif, ...prev]);\n    }\n  };\n\n  const handlePurchaseSuccess = (ticket: UserTicket) => {\n    setTickets((prev) => [ticket, ...prev]);\n    setSelectedTicketForPass(ticket);\n\n    const newNotif: NotificationItem = {\n      id: `notif-${Date.now()}`,\n      title: \'Achat de Billet Confirm\303\251\',\n      message: `Votre pass pour \"${ticket.eventTitle}\" (${ticket.tierName}) a \303\251t\303\251 ajout\303\251 \303\240 votre portefeuille.`,\n      timestamp: \'\303\200 l\342\200\231instant\',\n      read: false,\n      type: \'ticket\',\n    };\n    setNotifications((prev) => [newNotif, ...prev]);\n  };\n\n  const handleValidateTicket = (ticketId: string) => {\n    setTickets((prev) =>\n      prev.map((t) => (t.id === ticketId ? { ...t, status: \'used\' as const } : t))\n    );\n  };\n\n  const handleUpdateProfile = (updated: Partial<UserProfile>) => {\n    setUser((prev) => ({ ...prev, ...updated }));\n  };\n\n  const handleMarkNotificationRead = (id: string) => {\n    setNotifications((prev) =>\n      prev.map((n) => (n.id === id ? { ...n, read: true } : n))\n    );\n  };\n\n  const handleClearNotifications = () => {\n    setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));\n  };\n\n  if (!isAuthenticated) {\n    return <AuthView onLoginSuccess={handleLoginSuccess} />;\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#0F0F0F] text-[#E5E2E1] flex flex-col relative font-sans\">\n      {/* African pattern overlay */}\n      <div className=\"bg-pattern\" />\n\n      {/* WebGL Ambient Neon Fluid Background Shader */}\n      {ambientShader && <ShaderBackground intensity={0.55} />}\n\n      {/* Main App Layout */}\n      <div className=\"flex-1 flex flex-col relative z-10\">\n        {/* Top Header Bar */}\n        <Header\n          user={user}\n          notifications={notifications}\n          onMarkNotificationRead={handleMarkNotificationRead}\n          onClearNotifications={handleClearNotifications}\n          currentRole={currentRole}\n          onChangeRole={(role) => {\n            setCurrentRole(role);\n            setUser((prev) => ({ ...prev, role }));\n            if (role === \'admin\' && activeTab === \'home\') {\n              // keep context\n            }\n          }}\n          ambientShader={ambientShader}\n          onToggleShader={() => setAmbientShader(!ambientShader)}\n          onOpenCreateModal={() => setActiveTab(\'create\')}\n          pendingModerationCount={pendingModerationCount}\n          onNavigate={(tab) => setActiveTab(tab)}\n        />\n\n        {/* Sidebar on Desktop / Tablet */}\n        <Sidebar\n          user={user}\n          activeTab={activeTab}\n          onTabChange={(tab) => setActiveTab(tab)}\n          onOpenCreateModal={() => setActiveTab(\'create\')}\n          pendingModerationCount={pendingModerationCount}\n          totalEventsCount={events.filter((e) => e.status === \'approved\').length}\n        />\n\n        {/* Dynamic Main View Canvas */}\n        <main className=\"flex-1 px-4 sm:px-6 lg:pl-80 lg:pr-10 py-6 max-w-7xl w-full mx-auto\">\n          {activeTab === \'home\' && (\n            <HomeView\n              events={events}\n              onSelectEvent={(evt) => setSelectedEventForDetail(evt)}\n              onNavigateToExplore={() => setActiveTab(\'explore\')}\n              onNavigateToCreate={() => setActiveTab(\'create\')}\n            />\n          )}\n\n          {activeTab === \'explore\' && (\n            <ExploreView\n              events={events}\n              onSelectEvent={(evt) => setSelectedEventForDetail(evt)}\n            />\n          )}\n\n          {activeTab === \'create\' && (\n            <CreateEventView\n              onEventCreated={handleCreateEvent}\n              onBack={() => setActiveTab(\'home\')}\n              promoterName={user.name}\n              promoterAvatar={user.avatar}\n            />\n          )}\n\n          {activeTab === \'moderation\' && (\n            <ModerationView\n              events={events}\n              onApproveEvent={handleApproveEvent}\n              onRejectEvent={handleRejectEvent}\n              onPreviewEvent={(evt) => setSelectedEventForDetail(evt)}\n            />\n          )}\n\n          {activeTab === \'checkin\' && (\n            <CheckInScannerView\n              tickets={tickets}\n              onValidateTicket={handleValidateTicket}\n            />\n          )}\n\n          {activeTab === \'tickets\' && (\n            <TicketsWalletView\n              tickets={tickets}\n              onOpenPass={(tkt) => setSelectedTicketForPass(tkt)}\n              onExploreEvents={() => setActiveTab(\'home\')}\n            />\n          )}\n\n          {activeTab === \'profile\' && (\n            <ProfileView\n              user={user}\n              tickets={tickets}\n              onUpdateProfile={handleUpdateProfile}\n              onOpenTicketPass={(tkt) => setSelectedTicketForPass(tkt)}\n              onSignOut={handleSignOut}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* Floating Bottom Nav for Mobile Screens */}\n      <BottomNav\n        activeTab={activeTab}\n        onTabChange={(tab) => setActiveTab(tab)}\n        pendingCount={pendingModerationCount}\n        ticketsCount={tickets.length}\n        userRole={currentRole}\n      />\n\n      {/* Event Details & VIP Booking Modal */}\n      <EventDetailModal\n        event={selectedEventForDetail}\n        isOpen={selectedEventForDetail !== null}\n        onClose={() => setSelectedEventForDetail(null)}\n        onPurchaseSuccess={handlePurchaseSuccess}\n        userName={user.name}\n      />\n\n      {/* Digital Ticket Pass Modal */}\n      <TicketPassModal\n        ticket={selectedTicketForPass}\n        isOpen={selectedTicketForPass !== null}\n        onClose={() => setSelectedTicketForPass(null)}\n      />\n    </div>\n  );\n}\n"
    }
