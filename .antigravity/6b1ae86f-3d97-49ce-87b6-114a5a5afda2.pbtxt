        target_content: "// Environment variables or localStorage config\nconst getEnvVar = (key: string): string => {\n  if (typeof window !== \'undefined\') {\n    const local = localStorage.getItem(key);\n    if (local) return local;\n  }\n  return (import.meta as any).env?.[key] || \'\';\n};\n\nlet supabaseUrl = getEnvVar(\'VITE_SUPABASE_URL\') || \'https://xyzcompany.supabase.co\';\nlet supabaseAnonKey = getEnvVar(\'VITE_SUPABASE_ANON_KEY\') || \'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\';\n\nexport interface SupabaseConfig {\n  url: string;\n  anonKey: string;\n  isConnected: boolean;\n}\n\nexport interface TransactionRecord {\n  id: string;\n  ticketId: string;\n  eventId: string;\n  eventTitle: string;\n  promoterId: string;\n  promoterName: string;\n  customerName: string;\n  customerPhone: string;\n  paymentMethod: \'wave\' | \'om\' | \'yas\' | \'card\';\n  totalAmount: number; // in FCFA\n  promoterShare: number; // 90%\n  platformFee: number; // 10%\n  operatorFee: number; // 1%\n  status: \'completed\' | \'pending\' | \'refunded\';\n  createdAt: string;\n}\n\n// In-memory or localStorage store for persistence when offline or live demo\nconst STORAGE_EVENTS_KEY = \'thiesdn_events_v2\';\nconst STORAGE_TICKETS_KEY = \'thiesdn_tickets_v2\';\nconst STORAGE_TRANSACTIONS_KEY = \'thiesdn_transactions_v2\';\n\nlet cachedClient: SupabaseClient | null = null;\n\nexport const getSupabaseClient = (): SupabaseClient | null => {\n  const currentUrl = getEnvVar(\'VITE_SUPABASE_URL\');\n  const currentKey = getEnvVar(\'VITE_SUPABASE_ANON_KEY\');\n\n  if (!currentUrl || !currentKey || currentUrl.includes(\'xyzcompany\')) {\n    return null;\n  }\n\n  if (!cachedClient) {\n    try {\n      cachedClient = createClient(currentUrl, currentKey);\n    } catch (e) {\n      console.warn(\'Erreur initialisation Supabase Client:\', e);\n      return null;\n    }\n  }\n  return cachedClient;\n};\n\nexport const saveSupabaseCredentials = (url: string, anonKey: string) => {\n  if (typeof window !== \'undefined\') {\n    localStorage.setItem(\'VITE_SUPABASE_URL\', url.trim());\n    localStorage.setItem(\'VITE_SUPABASE_ANON_KEY\', anonKey.trim());\n    cachedClient = null; // reset client\n  }\n};\n\nexport const isSupabaseConfigured = (): boolean => {"
        replacement_content: "// Environment variables or localStorage config\nexport const normalizeSupabaseUrl = (url: string): string => {\n  let cleaned = (url || \'\').trim();\n  if (!cleaned) return \'\';\n  if (!cleaned.startsWith(\'http://\') && !cleaned.startsWith(\'https://\')) {\n    cleaned = `https://${cleaned}`;\n  }\n  // Remove /rest/v1 suffix if pasted by user\n  cleaned = cleaned.replace(/\\/rest\\/v1\\/?$/, \'\');\n  cleaned = cleaned.replace(/\\/+$/, \'\');\n  return cleaned;\n};\n\nconst getEnvVar = (key: string): string => {\n  if (typeof window !== \'undefined\') {\n    const local = localStorage.getItem(key);\n    if (local) return local;\n  }\n  return (import.meta as any).env?.[key] || \'\';\n};\n\nlet supabaseUrl = normalizeSupabaseUrl(getEnvVar(\'VITE_SUPABASE_URL\')) || \'https://xyzcompany.supabase.co\';\nlet supabaseAnonKey = getEnvVar(\'VITE_SUPABASE_ANON_KEY\') || \'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\';\n\nexport interface SupabaseConfig {\n  url: string;\n  anonKey: string;\n  isConnected: boolean;\n}\n\nexport interface TransactionRecord {\n  id: string;\n  ticketId: string;\n  eventId: string;\n  eventTitle: string;\n  promoterId: string;\n  promoterName: string;\n  customerName: string;\n  customerPhone: string;\n  paymentMethod: \'wave\' | \'om\' | \'yas\' | \'card\';\n  totalAmount: number; // in FCFA\n  promoterShare: number; // 90%\n  platformFee: number; // 10%\n  operatorFee: number; // 1%\n  status: \'completed\' | \'pending\' | \'refunded\';\n  createdAt: string;\n}\n\n// In-memory or localStorage store for persistence when offline or live demo\nconst STORAGE_EVENTS_KEY = \'thiesdn_events_v2\';\nconst STORAGE_TICKETS_KEY = \'thiesdn_tickets_v2\';\nconst STORAGE_TRANSACTIONS_KEY = \'thiesdn_transactions_v2\';\n\nlet cachedClient: SupabaseClient | null = null;\n\nexport const getSupabaseClient = (): SupabaseClient | null => {\n  const currentUrl = normalizeSupabaseUrl(getEnvVar(\'VITE_SUPABASE_URL\'));\n  const currentKey = getEnvVar(\'VITE_SUPABASE_ANON_KEY\').trim();\n\n  if (!currentUrl || !currentKey || currentUrl.includes(\'xyzcompany\')) {\n    return null;\n  }\n\n  if (!cachedClient) {\n    try {\n      cachedClient = createClient(currentUrl, currentKey);\n    } catch (e) {\n      console.warn(\'Erreur initialisation Supabase Client:\', e);\n      return null;\n    }\n  }\n  return cachedClient;\n};\n\nexport const saveSupabaseCredentials = (url: string, anonKey: string) => {\n  if (typeof window !== \'undefined\') {\n    const cleanUrl = normalizeSupabaseUrl(url);\n    localStorage.setItem(\'VITE_SUPABASE_URL\', cleanUrl);\n    localStorage.setItem(\'VITE_SUPABASE_ANON_KEY\', anonKey.trim());\n    cachedClient = null; // reset client\n  }\n};\n\nexport const isSupabaseConfigured = (): boolean => {\n  const url = normalizeSupabaseUrl(getEnvVar(\'VITE_SUPABASE_URL\'));\n  const key = getEnvVar(\'VITE_SUPABASE_ANON_KEY\');\n  return Boolean(url && key && !url.includes(\'xyzcompany\'));\n};"
