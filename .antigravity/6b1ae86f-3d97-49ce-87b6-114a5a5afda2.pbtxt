        target_content: "@import \"tailwindcss\";\n"
        replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Inter\', sans-serif;\n    background-color: #0f0f0f;\n    color: #e5e2e1;\n    min-height: 100vh;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-heading {\n    font-family: \'Montserrat\', sans-serif;\n  }\n}\n\n.bg-pattern {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 0;\n  opacity: 0.03;\n  background-image: url(\"data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n}\n\n.glass-panel {\n  background: rgba(31, 31, 31, 0.7);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.glass-panel-gold {\n  background: rgba(36, 26, 0, 0.5);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(233, 195, 73, 0.25);\n}\n\n.input-glass {\n  background-color: #1a1a1a;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  transition: all 0.25s ease;\n}\n\n.input-glass:focus-within {\n  border-color: #8a2be2;\n  box-shadow: 0 0 14px rgba(138, 43, 226, 0.28);\n}\n\n.btn-primary-glow {\n  background-color: #8a2be2;\n  color: #ffffff;\n  box-shadow: 0 0 18px rgba(138, 43, 226, 0.35);\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.btn-primary-glow:hover {\n  box-shadow: 0 0 24px rgba(138, 43, 226, 0.55);\n  transform: translateY(-1px);\n}\n\n.btn-gold-glow {\n  background-color: #e9c349;\n  color: #241a00;\n  box-shadow: 0 0 16px rgba(233, 195, 73, 0.3);\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.btn-gold-glow:hover {\n  box-shadow: 0 0 24px rgba(233, 195, 73, 0.5);\n  transform: translateY(-1px);\n}\n\n/* Custom scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #131313;\n}\n::-webkit-scrollbar-thumb {\n  background: #333333;\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #8a2be2;\n}\n"
      }
      num_matches: 1
    }
  }
