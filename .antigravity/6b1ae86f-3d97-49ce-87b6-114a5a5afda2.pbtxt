  file_change {
    absolute_path_uri: "file:///src/views/CheckInScannerView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { QrCode, Scan, CheckCircle, XCircle, Search, ShieldCheck, Users, Sparkles, RefreshCw } from \'lucide-react\';\nimport { UserTicket } from \'../types\';\n\ninterface CheckInScannerViewProps {\n  tickets: UserTicket[];\n  onValidateTicket: (ticketId: string) => void;\n}\n\nexport const CheckInScannerView: React.FC<CheckInScannerViewProps> = ({\n  tickets,\n  onValidateTicket,\n}) => {\n  const [searchCode, setSearchCode] = useState(\'\');\n  const [scanResult, setScanResult] = useState<{\n    status: \'success\' | \'error\' | null;\n    message: string;\n    ticket?: UserTicket;\n  }>({ status: null, message: \'\' });\n\n  const [activeTab, setActiveTab] = useState<\'scan\' | \'list\'>(\'scan\');\n\n  const handleVerifyCode = (code: string) => {\n    const cleanCode = code.trim().toUpperCase();\n    const found = tickets.find(\n      (t) => t.qrCode.toUpperCase() === cleanCode || t.id.toUpperCase() === cleanCode\n    );\n\n    if (found) {\n      if (found.status === \'used\') {\n        setScanResult({\n          status: \'error\',\n          message: \'Ce pass a d\303\251j\303\240 \303\251t\303\251 valid\303\251 \303\240 l\342\200\231entr\303\251e !\',\n          ticket: found,\n        });\n      } else {\n        onValidateTicket(found.id);\n        setScanResult({\n          status: \'success\',\n          message: `Acc\303\250s Autoris\303\251 : ${found.tierName}`,\n          ticket: { ...found, status: \'used\' },\n        });\n      }\n    } else {\n      setScanResult({\n        status: \'error\',\n        message: \'Billet non reconnu ou invalide dans le syst\303\250me.\',\n      });\n    }\n  };\n\n  return (\n    <div className=\"max-w-2xl mx-auto space-y-6 pb-20 animate-in fade-in duration-300\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"font-heading text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n            Scanner & Check-in\n          </h1>\n          <p className=\"text-sm text-gray-400 mt-1\">\n            Contr\303\264le d\342\200\231acc\303\250s et validation des pass en temps r\303\251el\n          </p>\n        </div>\n\n        <div className=\"flex bg-[#1C1B1B] p-1 rounded-xl border border-white/10\">\n          <button\n            onClick={() => setActiveTab(\'scan\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${\n              activeTab === \'scan\' ? \'bg-[#8A2BE2] text-white\' : \'text-gray-400\'\n            }`}\n          >\n            Scanner\n          </button>\n          <button\n            onClick={() => setActiveTab(\'list\')}\n            className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${\n              activeTab === \'list\' ? \'bg-[#8A2BE2] text-white\' : \'text-gray-400\'\n            }`}\n          >\n            Liste Pass ({tickets.length})\n          </button>\n        </div>\n      </div>\n\n      {activeTab === \'scan\' ? (\n        <div className=\"space-y-6\">\n          {/* Simulated Camera Viewfinder */}\n          <div className=\"relative h-72 sm:h-80 rounded-3xl overflow-hidden bg-gradient-to-b from-[#181822] via-[#0e0e13] to-[#0a0a0c] border-2 border-[#8A2BE2]/40 flex flex-col items-center justify-center p-6 shadow-2xl\">\n            {/* Corner brackets */}\n            <div className=\"absolute top-6 left-6 w-8 h-8 border-t-2 border-l-2 border-[#E9C349]\" />\n            <div className=\"absolute top-6 right-6 w-8 h-8 border-t-2 border-r-2 border-[#E9C349]\" />\n            <div className=\"absolute bottom-6 left-6 w-8 h-8 border-b-2 border-l-2 border-[#E9C349]\" />\n            <div className=\"absolute bottom-6 right-6 w-8 h-8 border-b-2 border-r-2 border-[#E9C349]\" />\n\n            {/* Scanning line animation */}\n            <div className=\"w-52 h-52 border border-[#8A2BE2]/50 rounded-2xl relative flex items-center justify-center\">\n              <QrCode className=\"w-32 h-32 text-[#8A2BE2]/40 animate-pulse\" />\n              <div className=\"absolute top-0 inset-x-0 h-0.5 bg-gradient-to-r from-transparent via-[#E9C349] to-transparent shadow-[0_0_12px_#E9C349] animate-bounce\" />\n            </div>\n\n            <p className=\"text-xs text-[#DCB8FF] mt-4 font-semibold flex items-center gap-1.5\">\n              <Scan className=\"w-4 h-4\" /> Pointez le QR code du participant\n            </p>\n          </div>\n\n          {/* Manual Input or Quick Test */}\n          <div className=\"glass-panel p-5 rounded-2xl space-y-3\">\n            <label className=\"text-xs font-bold uppercase tracking-wider text-gray-400\">\n              Saisie Manuelle du Code Pass\n            </label>\n            <div className=\"flex gap-2\">\n              <input\n                type=\"text\"\n                value={searchCode}\n                onChange={(e) => setSearchCode(e.target.value)}\n                placeholder=\"Ex: THIESDN-VIP-...\"\n                className=\"input-glass flex-1 rounded-xl px-4 py-3 text-sm text-white focus:outline-none\"\n              />\n              <button\n                onClick={() => handleVerifyCode(searchCode)}\n                className=\"btn-primary-glow px-5 rounded-xl font-heading font-bold text-xs uppercase\"\n              >\n                V\303\251rifier\n              </button>\n            </div>\n\n            {/* Quick test buttons with available tickets */}\n            {tickets.length > 0 && (\n              <div className=\"pt-2\">\n                <p className=\"text-[10px] text-gray-400 mb-1.5 uppercase font-bold\">\n                  Billet(s) pr\303\252t(s) pour le test :\n                </p>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {tickets.map((t) => (\n                    <button\n                      key={t.id}\n                      onClick={() => {\n                        setSearchCode(t.qrCode);\n                        handleVerifyCode(t.qrCode);\n                      }}\n                      className=\"px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-[#DCB8FF] border border-white/5 font-mono\"\n                    >\n                      {t.holderName} ({t.tierName})\n                    </button>\n                  ))}\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Scan result display */}\n          {scanResult.status && (\n            <div\n              className={`p-5 rounded-2xl border animate-in zoom-in-95 duration-200 ${\n                scanResult.status === \'success\'\n                  ? \'bg-emerald-950/70 border-emerald-500 text-emerald-200\'\n                  : \'bg-red-950/70 border-red-500 text-red-200\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                {scanResult.status === \'success\' ? (\n                  <CheckCircle className=\"w-8 h-8 text-emerald-400 flex-shrink-0\" />\n                ) : (\n                  <XCircle className=\"w-8 h-8 text-red-400 flex-shrink-0\" />\n                )}\n                <div>\n                  <h4 className=\"font-heading font-bold text-base text-white\">\n                    {scanResult.message}\n                  </h4>\n                  {scanResult.ticket && (\n                    <p className=\"text-xs opacity-85 mt-0.5\">\n                      Titulaire: {scanResult.ticket.holderName} \342\200\242 \303\211v\303\251nement: {scanResult.ticket.eventTitle}\n                    </p>\n                  )}\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n      ) : (\n        /* List of Attendees */\n        <div className=\"space-y-3\">\n          {tickets.map((tkt) => (\n            <div\n              key={tkt.id}\n              className=\"glass-panel p-4 rounded-2xl flex items-center justify-between gap-3\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <img\n                  src={tkt.eventPoster}\n                  alt={tkt.eventTitle}\n                  className=\"w-12 h-12 rounded-xl object-cover\"\n                />\n                <div>\n                  <h4 className=\"font-heading font-bold text-sm text-white\">\n                    {tkt.holderName}\n                  </h4>\n                  <p className=\"text-xs text-[#DCB8FF]\">{tkt.eventTitle} \342\200\242 {tkt.tierName}</p>\n                  <p className=\"text-[10px] text-gray-400 font-mono mt-0.5\">{tkt.qrCode}</p>\n                </div>\n              </div>\n\n              <div className=\"text-right\">\n                <span\n                  className={`text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full ${\n                    tkt.status === \'used\'\n                      ? \'bg-gray-700 text-gray-300\'\n                      : \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\'\n                  }`}\n                >\n                  {tkt.status === \'used\' ? \'Valid\303\251\' : \'Valide\'}\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
