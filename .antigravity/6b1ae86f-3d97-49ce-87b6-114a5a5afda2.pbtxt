    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { X, QrCode, Calendar, MapPin, Download, Share2, Sparkles, Crown, CheckCircle } from \'lucide-react\';\nimport { UserTicket } from \'../types\';\n\ninterface TicketPassModalProps {\n  ticket: UserTicket | null;\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const TicketPassModal: React.FC<TicketPassModalProps> = ({\n  ticket,\n  isOpen,\n  onClose,\n}) => {\n  if (!isOpen || !ticket) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md overflow-y-auto animate-in fade-in duration-200\">\n      <div className=\"relative w-full max-w-sm sm:max-w-md bg-gradient-to-b from-[#221F28] via-[#171717] to-[#121212] border border-[#8A2BE2]/40 rounded-3xl overflow-hidden shadow-2xl my-6\">\n        {/* Top bar */}\n        <div className=\"p-4 flex items-center justify-between border-b border-white/10\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-heading font-extrabold text-sm text-[#E9C349] flex items-center gap-1\">\n              <Crown className=\"w-4 h-4\" /> PASS THIESDN EXCLUSIF\n            </span>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Pass Visual Card */}\n        <div className=\"p-6 space-y-5\">\n          {/* Header image banner */}\n          <div className=\"relative h-36 rounded-2xl overflow-hidden border border-white/10\">\n            <img\n              src={ticket.eventPoster}\n              alt={ticket.eventTitle}\n              className=\"w-full h-full object-cover\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent\" />\n            <div className=\"absolute bottom-3 inset-x-3\">\n              <span className=\"bg-[#E9C349] text-[#241A00] text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full mb-1 inline-block\">\n                {ticket.tierName}\n              </span>\n              <h3 className=\"font-heading text-lg font-bold text-white leading-tight\">\n                {ticket.eventTitle}\n              </h3>\n            </div>\n          </div>\n\n          {/* Ticket metadata */}\n          <div className=\"grid grid-cols-2 gap-3 bg-[#1F1F1F] p-4 rounded-2xl border border-white/5 text-xs\">\n            <div>\n              <p className=\"text-[10px] uppercase text-gray-400 font-bold\">Titulaire</p>\n              <p className=\"font-bold text-white truncate\">{ticket.holderName}</p>\n            </div>\n            <div>\n              <p className=\"text-[10px] uppercase text-gray-400 font-bold\">Placement</p>\n              <p className=\"font-bold text-[#DCB8FF]\">{ticket.seatNumber || \'VIP Acc\303\250s\'}</p>\n            </div>\n            <div>\n              <p className=\"text-[10px] uppercase text-gray-400 font-bold\">Date & Heure</p>\n              <p className=\"font-semibold text-white\">{ticket.eventDate}</p>\n              <p className=\"text-gray-400\">{ticket.eventTime}</p>\n            </div>\n            <div>\n              <p className=\"text-[10px] uppercase text-gray-400 font-bold\">Prix R\303\251gl\303\251</p>\n              <p className=\"font-bold text-[#E9C349]\">{ticket.price.toLocaleString(\'fr-FR\')} FCFA</p>\n            </div>\n          </div>\n\n          {/* Location */}\n          <div className=\"flex items-center gap-2.5 p-3 rounded-xl bg-white/5 text-xs text-gray-300\">\n            <MapPin className=\"w-4 h-4 text-[#8A2BE2] flex-shrink-0\" />\n            <span className=\"truncate\">{ticket.eventVenue}</span>\n          </div>\n\n          {/* QR Code Section */}\n          <div className=\"p-5 rounded-2xl bg-white text-black flex flex-col items-center justify-center text-center shadow-lg relative\">\n            <div className=\"p-2 rounded-xl bg-black/5 mb-2\">\n              <QrCode className=\"w-36 h-36 text-[#131313]\" />\n            </div>\n            <p className=\"font-mono text-xs font-bold tracking-widest text-[#241A00]\">\n              {ticket.qrCode}\n            </p>\n            <p className=\"text-[10px] text-gray-500 mt-1 flex items-center gap-1 font-sans\">\n              <CheckCircle className=\"w-3 h-3 text-emerald-600\" />\n              Pr\303\251sentez ce QR Code au contr\303\264le d\'acc\303\250s\n            </p>\n          </div>\n\n          {/* Actions */}\n          <div className=\"flex gap-2\">\n            <button\n              onClick={() => {\n                alert(\'Pass t\303\251l\303\251charg\303\251 en format haute r\303\251solution dans votre galerie !\');\n              }}\n              className=\"flex-1 py-3 px-4 rounded-xl bg-[#8A2BE2] hover:bg-[#7822c9] text-white font-heading font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-md shadow-[#8A2BE2]/30\"\n            >\n              <Download className=\"w-4 h-4\" />\n              T\303\251l\303\251charger Pass\n            </button>\n            <button\n              onClick={() => {\n                if (navigator.share) {\n                  navigator.share({\n                    title: ticket.eventTitle,\n                    text: `Mon pass pour ${ticket.eventTitle} sur Thiesdn Billetterie`,\n                  }).catch(() => {});\n                } else {\n                  alert(\'Lien du pass copi\303\251 dans le presse-papier !\');\n                }\n              }}\n              className=\"py-3 px-4 rounded-xl bg-[#1F1F1F] hover:bg-[#2A2A2A] text-[#DCB8FF] border border-white/10 font-heading font-bold text-xs flex items-center justify-center gap-2 transition-all\"\n            >\n              <Share2 className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
